---
// Constructor de imanes (idea tomada del catálogo de imanes de Vistaprint, que
// hace imanes de nevera, de tarjeta de presentación, postales, calendarios y de
// puerta de vehículo, en 0.4 y 0.6 mm y de 0.85 mm los de carro). El dueño
// confirmó las cuatro medidas, el de vehículo y los tres grosores. Lo propio de
// este producto es dónde se pega: el constructor lo enseña a escala, en la
// puerta de la nevera o en la de la camioneta, y avisa que solo agarra en
// lámina de acero. No muestra precios: el precio va en la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// La cara impresa del imán: laminada brillante o mate. tex: cómo se dibuja.
const FACES = [
  { id: "brillante", es: "Brillante", en: "Glossy", base: "#FFFFFF", edge: "#DCE1E6", ink: "#14161A", sub: "#5A616B", tex: "brillo" },
  { id: "mate", es: "Mate", en: "Matte", base: "#FCFCFB", edge: "#DEDFDC", ink: "#14161A", sub: "#5A616B", tex: "mate" },
];

// La paleta LED del logo más neutros de imprenta
const ACCENTS = [
  { id: "azul", es: "Azul LED", en: "LED blue", hex: "#0094DA" },
  { id: "amarillo", es: "Amarillo LED", en: "LED yellow", hex: "#FFCA09" },
  { id: "verde", es: "Verde LED", en: "LED green", hex: "#99C941" },
  { id: "rojo", es: "Rojo LED", en: "LED red", hex: "#ED1B24" },
  { id: "negro", es: "Negro", en: "Black", hex: "#0B0C0E" },
  { id: "pizarra", es: "Gris pizarra", en: "Slate grey", hex: "#59626D" },
  { id: "marino", es: "Azul marino", en: "Navy", hex: "#16304F" },
  { id: "vino", es: "Vino", en: "Wine", hex: "#7A1F2B" },
  { id: "oliva", es: "Verde oliva", en: "Olive", hex: "#4F5B32" },
  { id: "terracota", es: "Terracota", en: "Terracotta", hex: "#B4522E" },
];

// Tiradas: los de nevera se piden por cientos, los de vehículo por pares
const QTYS = { promo: [25, 50, 100, 250, 500], carro: [2, 4, 6, 10] };

const MONTHS = {
