---
// Constructor de channel letters (idea tomada de buysignletters.com): el cliente escribe el
// nombre de su negocio, elige letra, altura, iluminación, colores de la cara y del canto,
// profundidad y montaje; ve las letras en una fachada de día y de noche, con el largo
// aproximado, y envía el diseño directo al correo. No muestra precios.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Las 5 letras con las que se fabrican las channel letters (lista del cliente, 2026-09-25).
// name es el nombre que ve el cliente y llega en la cotización. css es la letra de la vista previa:
// Arial y Arial Narrow se usan si el equipo las tiene; si no, una de Google Fonts de medidas parecidas.
// Gilroy y Assemblage son de pago, así que por ahora se ven con una parecida de Google Fonts.
const FONTS = [
  { id: "arial-narrow", name: "Arial Narrow Bold", css: `"Arial Narrow","Archivo Narrow",sans-serif`, weight: 700, q: "Archivo+Narrow:wght@700" },
  { id: "arial", name: "Arial Bold", css: `Arial,Arimo,sans-serif`, weight: 700, q: "Arimo:wght@700" },
  { id: "assemblage", name: "Assemblage Black", css: `"Archivo Black",sans-serif`, weight: 400, q: "Archivo+Black" },
  { id: "gilroy", name: "Gilroy Bold", css: `Poppins,sans-serif`, weight: 700, q: "Poppins:wght@700" },
  { id: "montserrat", name: "Montserrat Medium", css: `Montserrat,sans-serif`, weight: 500, q: "Montserrat:wght@500" },
];
const fontsHref = `https://fonts.googleapis.com/css2?${FONTS.map((f) => `family=${f.q}`).join("&")}&display=swap`;

// Acrílico de la cara: color de día y color encendido
const FACES = [
  { id: "blanco", hex: "#F4F4EF", glow: "#FFFFFF", es: "Blanco", en: "White" },
  { id: "rojo", hex: "#D1202A", glow: "#FF4436", es: "Rojo", en: "Red" },
  { id: "azul", hex: "#0E4FA8", glow: "#3C8BFF", es: "Azul", en: "Blue" },
  { id: "verde", hex: "#10853D", glow: "#3DEB6A", es: "Verde", en: "Green" },
  { id: "amarillo", hex: "#FFC414", glow: "#FFE45C", es: "Amarillo", en: "Yellow" },
  { id: "naranja", hex: "#F0661C", glow: "#FF9A3D", es: "Naranja", en: "Orange" },
  { id: "morado", hex: "#5A2A8C", glow: "#B45CFF", es: "Morado", en: "Purple" },
];
// Canto (lateral de aluminio pintado)
const RETURNS = [
  { id: "negro", hex: "#1D1E21", es: "Negro", en: "Black" },
  { id: "blanco", hex: "#E9E9E5", es: "Blanco", en: "White" },
  { id: "aluminio", hex: "#A7ACB1", es: "Aluminio", en: "Aluminum" },
  { id: "bronce", hex: "#5E4129", es: "Bronce", en: "Bronze" },
  { id: "cara", hex: "", es: "Igual a la cara", en: "Match the face" },
];
// Luz del halo (la que se refleja en la pared)
const HALOS = [
  { id: "frio", hex: "#EAF4FF", es: "Blanco frío", en: "Cool white" },
  { id: "calido", hex: "#FFD39A", es: "Blanco cálido", en: "Warm white" },
  { id: "rojo", hex: "#FF3B30", es: "Rojo", en: "Red" },
  { id: "azul", hex: "#3C8BFF", es: "Azul", en: "Blue" },
  { id: "verde", hex: "#3DEB6A", es: "Verde", en: "Green" },
];
const HEIGHTS = [12, 18, 24, 36];

const COPY = {
  es: {
    title: "Diseña tus channel letters",
    lead: "Escribe el nombre de tu negocio, elige la letra, la altura y los colores, y míralo en una fachada de día y de noche. Envíanos el diseño y te respondemos con el precio.",
    defaultText: "Café Miami",
    text: "Texto del letrero",
    textHelp: "Hasta 2 líneas. Cada letra es una pieza separada.",
    font: "Letra",
    size: "Altura de las letras",
    height: "Altura",
    lengthLbl: "Largo aprox. de la línea más larga",
    lengthNote: "Puede variar un 10 % según la letra. Si necesitas una medida exacta, escríbela en las notas.",
    light: "Iluminación",
    lights: { frontal: "Frontal", halo: "Halo (trasera)", ambas: "Frontal + halo", ninguna: "Sin luz" },
    lightHelp: {
      frontal: "La luz sale por la cara de acrílico.",
      halo: "La cara es de metal y la luz se refleja en la pared, detrás de cada letra.",
      ambas: "Se ilumina la cara y también la pared, detrás de cada letra.",
