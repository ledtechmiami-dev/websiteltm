---
// Gama de material impreso de marketing. Cada tarjeta lleva un dibujo del producto
// y las medidas estándar del oficio; el taller también corta a la medida. Sin precios:
// el precio depende del tiraje, el papel y el acabado, y va en la cotización.
import type { Lang } from "../data/site";
import { SERVICES, serviceUrl } from "../data/catalog";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const COPY = {
  es: {
    title: "Qué imprimimos",
    lead: "Estas son las medidas estándar del oficio, las que más se piden. También cortamos a la medida: si necesitas otra, dínoslo y la hacemos.",
    sizes: "Medidas",
    foot: "El precio depende del tiraje, el papel y el acabado. Mándanos qué necesitas y te lo cotizamos.",
    other: "¿Otro formato?",
    otherText: "Si lo que buscas no está en la lista, escríbenos: casi todo lo que se imprime en papel o cartulina lo hacemos.",
    cta: "Pide tu cotización",
    design: { tarjetas: "Diseña las tuyas", volantes: "Diseña los tuyos", folletos: "Diseña el tuyo", carpetas: "Diseña la tuya", rack: "Diseña las tuyas", imanes: "Diseña el tuyo", colgantes: "Diseña el tuyo", boletos: "Diseña los tuyos", menus: "Diseña el tuyo", manteles: "Diseña el tuyo", exhibidores: "Diseña el tuyo", etiquetas: "Diseña las tuyas" } as Record<string, string>,
  },
  en: {
    title: "What we print",
    lead: "These are the standard trade sizes, the ones most people ask for. We also cut to size: if you need a different one, tell us and we'll make it.",
    sizes: "Sizes",
    foot: "Price depends on the run, the paper and the finish. Send us what you need and we'll quote it.",
    other: "Something else?",
    otherText: "If what you're looking for isn't on the list, write to us: just about anything printed on paper or card stock, we do.",
    cta: "Get your quote",
    design: { tarjetas: "Design yours", volantes: "Design yours", folletos: "Design yours", carpetas: "Design yours", rack: "Design yours", imanes: "Design yours", colgantes: "Design yours", boletos: "Design yours", menus: "Design yours", manteles: "Design yours", exhibidores: "Design yours", etiquetas: "Design yours" } as Record<string, string>,
  },
};
const c = COPY[lang];

// Cada medida va en su propio trozo: así una fracción nunca se parte en dos renglones
const ITEMS = [
  { id: "tarjetas", es: "Tarjetas de presentación", en: "Business cards",
    sizeEs: ["3-1/2 × 2 in", "cuadrada 2-1/2 × 2-1/2 in"], sizeEn: ["3-1/2 × 2 in", "square 2-1/2 × 2-1/2 in"] },
  { id: "volantes", es: "Volantes", en: "Flyers",
    sizeEs: ["8-1/2 × 11 in", "5-1/2 × 8-1/2 in", "4-1/4 × 5-1/2 in"], sizeEn: ["8-1/2 × 11 in", "5-1/2 × 8-1/2 in", "4-1/4 × 5-1/2 in"] },
  { id: "folletos", es: "Folletos", en: "Brochures",
    sizeEs: ["8-1/2 × 11 in a dos o tres cuerpos", "8-1/2 × 14 in", "11 × 17 in doblado"],
    sizeEn: ["8-1/2 × 11 in bi- or tri-fold", "8-1/2 × 14 in", "11 × 17 in folded"] },
  { id: "carpetas", es: "Carpetas de presentación", en: "Presentation folders",
    sizeEs: ["9 × 12 in con bolsillos", "6 × 9 in", "9-1/2 × 12 in reforzada"],
    sizeEn: ["9 × 12 in with pockets", "6 × 9 in", "9-1/2 × 12 in reinforced"] },
  { id: "rack", es: "Tarjetas de exhibidor", en: "Rack cards",
    sizeEs: ["4 × 9 in", "3-1/2 × 8-1/2 in", "4-1/4 × 11 in"], sizeEn: ["4 × 9 in", "3-1/2 × 8-1/2 in", "4-1/4 × 11 in"] },
  { id: "imanes", es: "Imanes", en: "Magnets",
    sizeEs: ["3-1/2 × 2 in", "4 × 6 in", "5 × 7 in", "18 × 12 in para vehículo"],
    sizeEn: ["3-1/2 × 2 in", "4 × 6 in", "5 × 7 in", "18 × 12 in for vehicles"] },
  { id: "colgantes", es: "Colgantes de puerta", en: "Door hangers",
    sizeEs: ["4-1/4 × 11 in, troquelados", "3-1/2 × 8-1/2 in", "4-1/4 × 14 in"],
    sizeEn: ["4-1/4 × 11 in, die-cut", "3-1/2 × 8-1/2 in", "4-1/4 × 14 in"] },
  { id: "boletos", es: "Boletos", en: "Tickets",
    sizeEs: ["5-1/2 × 2 in", "6-1/2 × 2-1/8 in", "numerados y con talón"],
    sizeEn: ["5-1/2 × 2 in", "6-1/2 × 2-1/8 in", "numbered with a stub"] },
  { id: "menus", es: "Menús", en: "Menus",
    sizeEs: ["8-1/2 × 11 in", "8-1/2 × 14 in", "laminado para limpiar"],
    sizeEn: ["8-1/2 × 11 in", "8-1/2 × 14 in", "laminated to wipe clean"] },
  { id: "manteles", es: "Manteles individuales", en: "Placemats",
    sizeEs: ["14 × 10 in", "17 × 11 in", "18 × 12 in"], sizeEn: ["14 × 10 in", "17 × 11 in", "18 × 12 in"] },
  { id: "etiquetas", es: "Etiquetas", en: "Labels",
    sizeEs: ["redondas de 1-1/2, 2 y 3 in", "ovaladas y cuadradas", "rectangulares hasta 4 × 3 in"],
    sizeEn: ["1-1/2, 2 and 3 in round", "oval and square", "rectangular up to 4 × 3 in"] },
  { id: "exhibidores", es: "Exhibidores de mesa", en: "Tabletop displays",
    sizeEs: ["carpa de mesa 4 × 6 y 5 × 7 in", "mini banner 8-1/2 × 12 in", "mini banner 11 × 17 in"],
    sizeEn: ["4 × 6 and 5 × 7 in tent cards", "8-1/2 × 12 in mini banner", "11 × 17 in mini banner"] },
];

// Productos que además tienen su propia página con constructor
const BUILDER_OF: Record<string, string> = {
  tarjetas: "tarjetas-presentacion",
  volantes: "volantes",
  folletos: "folletos",
  carpetas: "carpetas-presentacion",
  rack: "tarjetas-exhibidor",
  imanes: "imanes",
  colgantes: "colgantes-puerta",
  boletos: "boletos",
  menus: "menus",
  manteles: "manteles-individuales",
  exhibidores: "exhibidores-mesa",
  etiquetas: "etiquetas",
};
const LINKS: Record<string, string> = {};
for (const [id, key] of Object.entries(BUILDER_OF)) {
  const svc = SERVICES.find((s) => s.key === key);
  if (svc) LINKS[id] = serviceUrl(svc, lang);
}

const LED = ["#0094DA", "#FFCA09", "#99C941", "#ED1B24"];
// Renglones de texto simulado: y, ancho
const lines = (y0: number, n: number, w: number, gap = 7) =>
  Array.from({ length: n }, (_, i) => ({ y: y0 + i * gap, w: i === n - 1 ? w * 0.62 : w }));
---
<section class="section section--flush" id="materiales">
  <div class="container">
    <div class="sec-head">
      <div>
        <h2>{c.title}</h2>
        <p>{c.lead}</p>
      </div>
    </div>

    <ul class="pc">
      {ITEMS.map((it, i) => (
        <li class="pc__item">
          <div class="pc__art" style={`--a:${LED[i % LED.length]}`}>
            <svg viewBox="0 0 120 92" aria-hidden="true" focusable="false">
              {it.id === "tarjetas" && (
                <g>
                  <rect class="pc-p pc-p--back" x="26" y="24" width="63" height="36" rx="3" />
                  <rect class="pc-p" x="34" y="34" width="63" height="36" rx="3" />
                  <rect class="pc-a" x="41" y="41" width="16" height="4" rx="2" />
                  {lines(51, 2, 34).map((l) => <rect class="pc-t" x="41" y={l.y} width={l.w} height="2.4" rx="1.2" />)}
                </g>
              )}
              {it.id === "volantes" && (
                <g>
                  <rect class="pc-p pc-p--back" x="22" y="16" width="52" height="67" rx="3" />
                  <rect class="pc-p" x="38" y="10" width="52" height="67" rx="3" />
                  <rect class="pc-a" x="45" y="17" width="38" height="18" rx="2" />
                  {lines(42, 5, 38).map((l) => <rect class="pc-t" x="45" y={l.y} width={l.w} height="2.6" rx="1.3" />)}
                </g>
              )}
              {it.id === "folletos" && (
                <g>
                  <path class="pc-p" d="M16 24h32v50H16z" />
                  <path class="pc-p pc-p--mid" d="M48 18h30v62H48z" />
                  <path class="pc-p" d="M78 24h26v50H78z" />
                  <rect class="pc-a" x="54" y="26" width="18" height="14" rx="2" />
                  {lines(46, 4, 18).map((l) => <rect class="pc-t" x="54" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                  {lines(32, 4, 20).map((l) => <rect class="pc-t" x="22" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                </g>
              )}
              {it.id === "carpetas" && (
                <g>
                  <rect class="pc-p" x="26" y="12" width="68" height="70" rx="3" />
                  <rect class="pc-a" x="36" y="22" width="20" height="14" rx="2" />
                  <rect class="pc-t" x="36" y="41" width="30" height="2.6" rx="1.3" />
                  <path class="pc-p pc-p--mid" d="M26 54h68v28H26z" />
                  <path class="pc-cut" d="M46 54h28v5a5 5 0 0 1-5 5H51a5 5 0 0 1-5-5z" />
                </g>
              )}
              {it.id === "rack" && (
                <g>
                  <rect class="pc-p" x="44" y="8" width="32" height="72" rx="3" />
                  <rect class="pc-a" x="50" y="14" width="20" height="22" rx="2" />
                  {lines(42, 4, 20, 6).map((l) => <rect class="pc-t" x="50" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                  <path class="pc-h" d="M36 66h48v4a6 6 0 0 1-6 6H42a6 6 0 0 1-6-6z" />
                </g>
              )}
              {it.id === "imanes" && (
                <g>
                  <rect class="pc-p pc-p--back" x="30" y="30" width="60" height="40" rx="5" />
                  <rect class="pc-p" x="30" y="26" width="60" height="40" rx="5" />
                  <rect class="pc-a" x="38" y="34" width="18" height="18" rx="2" />
                  {lines(36, 3, 24, 7).map((l) => <rect class="pc-t" x="62" y={l.y} width={l.w} height="2.4" rx="1.2" />)}
                </g>
              )}
              {it.id === "colgantes" && (
                <g>
                  <path class="pc-p" d="M43 6h34a3 3 0 0 1 3 3v74a3 3 0 0 1-3 3H43a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3z" />
                  <circle class="pc-cut" cx="60" cy="19" r="7" />
                  <path class="pc-cut" d="M57 19h6v-9h-6z" />
                  <rect class="pc-a" x="48" y="34" width="24" height="16" rx="2" />
                  {lines(56, 3, 24, 6).map((l) => <rect class="pc-t" x="48" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                </g>
              )}
              {it.id === "boletos" && (
                <g>
                  <path class="pc-p" d="M14 30h92a3 3 0 0 1 3 3v26a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V33a3 3 0 0 1 3-3z" />
                  <rect class="pc-a" x="18" y="37" width="30" height="18" rx="2" />
                  <rect class="pc-t" x="56" y="40" width="26" height="2.6" rx="1.3" />
                  <rect class="pc-t" x="56" y="47" width="18" height="2.6" rx="1.3" />
                  {Array.from({ length: 6 }, (_, k) => <circle class="pc-cut" cx="88" cy={35 + k * 5} r="1.4" />)}
                </g>
              )}
              {it.id === "menus" && (
                <g>
                  <rect class="pc-p" x="34" y="8" width="52" height="76" rx="3" />
                  <rect class="pc-a" x="42" y="16" width="36" height="10" rx="2" />
                  {[0, 1, 2, 3].map((k) => (
                    <g>
                      <rect class="pc-t" x="42" y={36 + k * 12} width="24" height="2.4" rx="1.2" />
                      <rect class="pc-t pc-t--dim" x="42" y={41 + k * 12} width="14" height="2" rx="1" />
                      <rect class="pc-t" x="72" y={36 + k * 12} width="6" height="2.4" rx="1.2" />
                    </g>
                  ))}
                </g>
              )}
              {it.id === "manteles" && (
                <g>
                  <rect class="pc-p" x="8" y="22" width="104" height="48" rx="3" />
                  <circle class="pc-t pc-t--dim" cx="60" cy="46" r="15" />
                  <circle class="pc-p pc-p--mid" cx="60" cy="46" r="9" />
                  <rect class="pc-t" x="30" y="40" width="3" height="13" rx="1.5" />
                  <rect class="pc-t" x="87" y="40" width="3" height="13" rx="1.5" />
                  <rect class="pc-a" x="14" y="27" width="16" height="5" rx="2.5" />
                </g>
              )}
              {it.id === "etiquetas" && (
                <g>
                  <rect class="pc-p" x="16" y="18" width="88" height="56" rx="4" />
                  <circle class="pc-p pc-p--mid" cx="42" cy="46" r="18" />
                  <circle class="pc-a" cx="42" cy="46" r="9" />
                  <rect class="pc-p pc-p--mid" x="68" y="28" width="30" height="16" rx="8" />
                  <rect class="pc-p pc-p--mid" x="68" y="50" width="30" height="16" rx="3" />
                  {lines(32, 2, 18, 6).map((l) => <rect class="pc-t" x="74" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                  {lines(54, 2, 18, 6).map((l) => <rect class="pc-t" x="74" y={l.y} width={l.w} height="2.2" rx="1.1" />)}
                </g>
              )}
              {it.id === "exhibidores" && (
                <g>
                  <path class="pc-p" d="M60 16 36 72h24z" />
                  <path class="pc-p pc-p--mid" d="M60 16l24 56H60z" />
                  <rect class="pc-a" x="52" y="36" width="16" height="12" rx="2" />
                  <rect class="pc-t" x="48" y="54" width="24" height="2.4" rx="1.2" />
                  <rect class="pc-t" x="52" y="60" width="16" height="2.2" rx="1.1" />
                  <rect class="pc-h" x="26" y="72" width="68" height="4" rx="2" />
                </g>
              )}
            </svg>
          </div>
          <div class="pc__body">
            <h3>{lang === "es" ? it.es : it.en}</h3>
            <p class="pc__size">
              <span class="pc__lbl">{c.sizes}</span>
              {(lang === "es" ? it.sizeEs : it.sizeEn).map((s) => <span class="pc__sz">{s}</span>)}
            </p>
            {LINKS[it.id] && (
              <a class="more pc__more" href={LINKS[it.id]}>
                {c.design[it.id]}<svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg>
              </a>
            )}
          </div>
        </li>
      ))}

      <li class="pc__item pc__item--ask">
        <div class="pc__body">
          <h3>{c.other}</h3>
          <p>{c.otherText}</p>
          <a class="btn btn--small" href="#cotizar">{c.cta}</a>
        </div>
      </li>
    </ul>

    <p class="pc__foot">{c.foot}</p>
  </div>
</section>
