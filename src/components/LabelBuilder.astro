---
// Constructor de etiquetas. La idea viene de las roll labels de Vistaprint,
// pero las opciones son las del taller, confirmadas por el dueño: solo los dos
// papeles (mate y brillante), solo en pliego y desde 100. Lo propio de este
// producto es que va pegada en algo: el constructor la pone en el frasco, la
// botella, la caja o la bolsa, a escala, y avisa si no cabe. No muestra precios
// de imprenta: el precio de la impresión va en la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Los dos papeles del taller. No hay plástico ni transparente: las dos son papel
// y el agua las arruga, que es lo que hay que avisar antes de imprimir.
const MATS = [
  { id: "mate", es: "Papel mate", en: "Matte paper", base: "#FFFFFF", edge: "#E7E8E6", ink: "#14161A", sub: "#5A616B", tex: "mate",
    sw: "linear-gradient(135deg, #FFF 0 52%, #EFF0EE)" },
  { id: "brillante", es: "Papel brillante", en: "Glossy paper", base: "#FFFFFF", edge: "#E4E8EB", ink: "#14161A", sub: "#5A616B", tex: "brillo",
    sw: "linear-gradient(118deg, #FFF 0 26%, #D8E2EA 44%, #FFF 62%, #EDF1F4)" },
];

// La paleta LED del logo más neutros de imprenta
const ACCENTS = [
  { id: "oliva", es: "Verde oliva", en: "Olive", hex: "#4F5B32" },
  { id: "terracota", es: "Terracota", en: "Terracotta", hex: "#B4522E" },
  { id: "vino", es: "Vino", en: "Wine", hex: "#7A1F2B" },
  { id: "marino", es: "Azul marino", en: "Navy", hex: "#16304F" },
  { id: "negro", es: "Negro", en: "Black", hex: "#0B0C0E" },
  { id: "pizarra", es: "Gris pizarra", en: "Slate grey", hex: "#59626D" },
  { id: "azul", es: "Azul LED", en: "LED blue", hex: "#0094DA" },
  { id: "amarillo", es: "Amarillo LED", en: "LED yellow", hex: "#FFCA09" },
  { id: "verde", es: "Verde LED", en: "LED green", hex: "#99C941" },
  { id: "rojo", es: "Rojo LED", en: "LED red", hex: "#ED1B24" },
];

const QTYS = [100, 250, 500, 1000];

