---
// Constructor de pisos de EVA foam para botes (idea tomada de los kits de Marine Mat):
// el cliente marca las áreas del bote, elige diseño, colores de las dos capas, textura
// y grabado, lo ve en un diagrama del bote y envía el diseño directo al correo.
// No muestra precios: el precio llega con la cotización, después de medir el bote.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

