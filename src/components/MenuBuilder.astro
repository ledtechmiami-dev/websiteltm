const c = COPY[lang];
const brochure = SERVICES.find((s) => s.key === "folletos");
const foldedUrl = brochure ? `${serviceUrl(brochure, lang)}#disena` : null;
const cfg = {
  stocks: STOCKS.map((s) => ({ id: s.id, base: s.base, edge: s.edge, ink: s.ink, sub: s.sub, tex: s.tex, name: s[lang] })),
  accents: ACCENTS.map((a) => ({ id: a.id, hex: a.hex, name: a[lang] })),
  shapes: c.shapes,
  shapeHelp: c.shapeHelp,
  lams: c.lams,
  lamHelp: c.lamHelp,
  sides: c.sideOpts,
  sideHelp: c.sideHelp,
  tpls: c.tpls,
  types: c.types,
  bgs: c.bgs,
  images: c.images,
  backs: c.backs,
  views: c.views,
  phone: SITE.phoneIntl,
  formValue,
  lang,
  copy: {
    photoBox: c.photoBox,
    hours: c.hours,
    zoneLbl: c.zoneLbl,
    front: c.front,
    backLbl: c.backLbl,
    approx: c.approx,
    guidesOn: c.guidesOn,
    zoneOn: c.zoneOn,
    summary: c.summary,
    sFormat: c.sFormat,
    sPaper: c.sPaper,
    sLam: c.sLam,
    sSides: c.sSides,
    sDesign: c.sDesign,
    sType: c.sType,
    sAccent: c.sAccent,
    sBg: c.sBg,
    sImage: c.sImage,
    sName: c.sName,
    sMenu: c.sMenu,
    sNote: c.sNote,
    sBiz: c.sBiz,
    sBack: c.sBack,
    sQty: c.sQty,
    sLink: c.sLink,
    waIntro: c.waIntro,
    preview: c.preview,
  },
};
const waPhoto = `https://wa.me/${SITE.phoneIntl}?text=${encodeURIComponent(c.imageWa)}`;
const seg = (name: string, options: Record<string, string>, checked?: string) =>
  Object.entries(options).map(([id, label], i) => ({ name, id, label, checked: checked ? id === checked : i === 0 }));
const TPLS = Object.keys(c.tpls);
---
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" />

<section class="section section--flush" id="disena">
  <div class="container">
    <div class="sec-head">
      <div>
        <h2>{c.title}</h2>
        <p>{c.lead}</p>
      </div>
    </div>

    <div class="nb mn" data-carta data-cfg={JSON.stringify(cfg)}>
      <div class="nb__stage">
        <canvas class="nb__canvas mn__canvas" role="img" aria-label={c.preview}></canvas>
        <div class="nb__tools">
          <button type="button" class="nb__tool" data-guides aria-pressed="false">
            <span class="nb__dot" aria-hidden="true"></span>{c.guides}
          </button>
          <button type="button" class="nb__tool" data-zone aria-pressed="false">
            <span class="nb__dot" aria-hidden="true"></span>{c.zone}
          </button>
          <button type="button" class="nb__tool mn__view" data-view title={c.viewHelp}>{c.views.ambas}</button>
        </div>
        <p class="nb__approx" data-approx>{c.approx}</p>
      </div>

      <form class="nb__panel" novalidate>
        <fieldset class="nb__group">
          <legend class="nb__label">{c.format}</legend>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.format}>
            {seg("formato", c.shapes).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help"><b data-size-out></b> · <span data-shape-help>{c.shapeHelp.carta}</span></p>
          {foldedUrl && (
            <p class="nb__help">{c.folded} <a class="eb__link" href={foldedUrl}>{c.foldedCta}</a>.</p>
          )}
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.paper}</legend>
          <div class="tb__mats">
            {STOCKS.map((s) => (
              <label class="tb__mat">
                <input type="radio" name="papel" value={s.id} checked={s.id === "mate"} />
                <i style={`--c:${s.sw}`} aria-hidden="true"></i>
                <span>{s[lang]}</span>
              </label>
            ))}
          </div>
          <p class="nb__help">{c.paperHelp}</p>
          <p class="tb__sub">{c.lam}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.lam} aria-describedby="mn-lam-help" data-lam>
            {seg("laminado", c.lams, "brillante").map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" id="mn-lam-help" data-lam-help>{c.lamHelp.brillante}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.print}</legend>
          <div class="nb__seg" role="radiogroup" aria-label={c.sides}>
            {seg("caras", c.sideOpts).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" data-side-help>{c.sideHelp.una}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.design}</legend>
          <div class="fb__pats mn__tpls" role="radiogroup" aria-label={c.design}>
            {TPLS.map((id, i) => (
              <label class="fb__pat mn__tpl">
                <input type="radio" name="plantilla" value={id} checked={i === 0} />
                <canvas width="150" height="194" aria-hidden="true"></canvas>
                <span>{c.tpls[id as keyof typeof c.tpls]}</span>
              </label>
            ))}
          </div>
          <p class="tb__sub">{c.bg}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.bg}>
            {seg("fondo", c.bgs).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="tb__sub">{c.type}</p>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.type}>
            {seg("tipografia", c.types, "clasica").map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="tb__sub">{c.accent} · <span class="eb__picked" data-accent-name>{ACCENTS[0][lang]}</span></p>
          <div class="eb__sws" role="radiogroup" aria-label={c.accent}>
            {ACCENTS.map((a, i) => (
              <label class="eb__sw" title={a[lang]}>
                <input type="radio" name="acento" value={a.id} checked={i === 0} />
                <i style={`--c:${a.hex}`} aria-hidden="true"></i>
                <span class="sr-only">{a[lang]}</span>
              </label>
            ))}
          </div>
          <p class="tb__sub">{c.image}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.image} data-image>
            {seg("imagen", c.images).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help">{c.imageHelp} <a class="eb__link" href={waPhoto} target="_blank" rel="noopener">{c.imageCta}</a>.</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.words}</legend>
          <div class="tb__words">
            <div class="form__row">
              <div class="field">
                <label for="mn-negocio">{c.business}</label>
                <input id="mn-negocio" type="text" name="negocio" maxlength="28" autocomplete="off" placeholder={c.businessPh} value={c.defBusiness} />
              </div>
              <div class="field">
                <label for="mn-lema">{c.tag}</label>
                <input id="mn-lema" type="text" name="lema" maxlength="34" autocomplete="off" placeholder={c.tagPh} value={c.defTag} />
              </div>
            </div>

            <div class="field">
              <label for="mn-sec1">{c.sec1}</label>
              <input id="mn-sec1" type="text" name="seccion1" maxlength="22" autocomplete="off" value={c.defSec1} />
            </div>
            <div class="mn__rows">
              {[1, 2, 3].map((n) => (
                <div class="mn__row">
                  <div class="field">
                    <input type="text" name={`plato${n}`} maxlength="28" autocomplete="off" value={c.dishes1[n - 1]} aria-label={`${c.dish} ${n}`} />
                  </div>
                  <div class="field">
                    <input type="text" name={`precio${n}`} maxlength="8" autocomplete="off" value={c.prices1[n - 1]} aria-label={`${c.priceCol} ${n}`} />
                  </div>
                </div>
              ))}
            </div>

            <div class="field mn__sec">
              <label for="mn-sec2">{c.sec2}</label>
              <input id="mn-sec2" type="text" name="seccion2" maxlength="22" autocomplete="off" value={c.defSec2} />
            </div>
            <div class="mn__rows">
              {[4, 5, 6].map((n) => (
                <div class="mn__row">
                  <div class="field">
                    <input type="text" name={`plato${n}`} maxlength="28" autocomplete="off" value={c.dishes2[n - 4]} aria-label={`${c.dish} ${n}`} />
                  </div>
                  <div class="field">
                    <input type="text" name={`precio${n}`} maxlength="8" autocomplete="off" value={c.prices2[n - 4]} aria-label={`${c.priceCol} ${n}`} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.biz}</legend>
          <div class="tb__words">
            <div class="field">
              <label for="mn-nota">{c.note}</label>
              <input id="mn-nota" type="text" name="nota" maxlength="50" autocomplete="off" placeholder={c.notePh} value={c.defNote} />
            </div>
            <div class="form__row">
              <div class="field">
                <label for="mn-tel">{c.phone}</label>
                <input id="mn-tel" type="text" name="tel" maxlength="24" autocomplete="off" placeholder={c.phonePh} value={c.defPhone} />
              </div>
              <div class="field">
                <label for="mn-web">{c.web}</label>
                <input id="mn-web" type="text" name="web" maxlength="30" autocomplete="off" placeholder={c.webPh} value={c.defWeb} />
              </div>
            </div>
            <div class="field">
              <label for="mn-dir">{c.address}</label>
              <input id="mn-dir" type="text" name="direccion" maxlength="40" autocomplete="off" placeholder={c.addressPh} value={c.defAddress} />
            </div>
          </div>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.back}</legend>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.back} data-back>
            {seg("reverso", c.backs).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" data-back-help hidden>{c.backHelp}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.order}</legend>
          <div class="nb__sizes">
            {QTYS.map((q) => (
              <button type="button" class="nb__pill" data-qty={q}>{q}</button>
            ))}
          </div>
          <div class="tb__row">
            <div class="field">
              <label for="mn-cantidad">{c.qty}</label>
              <input id="mn-cantidad" type="number" name="cantidad" min="25" max="100000" step="25" value="50" inputmode="numeric" aria-describedby="mn-qty-help" />
            </div>
          </div>
          <p class="nb__help" id="mn-qty-help">{c.qtyHelp}</p>
        </fieldset>

        <div class="nb__foot">
          <p class="nb__price">{c.price}</p>
          <BuilderContact lang={lang} idp="mn" cta={c.cta} notesPh={c.notesPh} />
          <a class="wa-link" data-wa href={`https://wa.me/${SITE.phoneIntl}`} target="_blank" rel="noopener">
            <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>{c.wa}
          </a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { wireQuote } from "../scripts/builder-quote";

  type Stock = { id: string; name: string; base: string; edge: string; ink: string; sub: string; tex: string };
  type Accent = { id: string; name: string; hex: string };
  type Cfg = {
    stocks: Stock[];
    accents: Accent[];
    shapes: Record<string, string>;
    shapeHelp: Record<string, string>;
    lams: Record<string, string>;
    lamHelp: Record<string, string>;
    sides: Record<string, string>;
    sideHelp: Record<string, string>;
    tpls: Record<string, string>;
    types: Record<string, string>;
    bgs: Record<string, string>;
    images: Record<string, string>;
    backs: Record<string, string>;
    views: Record<string, string>;
    phone: string;
    formValue: string;
    lang: string;
    copy: Record<string, string>;
  };
  type Section = { title: string; rows: Array<{ dish: string; price: string }> };
  // Lo que hay que dibujar en una plana, ya resuelto desde el formulario
  type Face = {
    w: number; // pulgadas
    h: number;
    stock: Stock;
    accent: string;
    type: string;
    tpl: string;
    bg: string;
    photo: boolean;
    lam: string;
    t: Record<string, string>;
    secs: Section[];
    mini: boolean;
  };

  // Medidas de menú plano, en pulgadas
  const SHAPES: Record<string, { w: number; h: number }> = {
    carta: { w: 8.5, h: 11 },
    legal: { w: 8.5, h: 14 },
  };
  const BLEED = 0.125; // sangrado de imprenta
  const SAFE = 0.25; // margen de seguridad hacia dentro

  const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  // Luminancia relativa: decide si sobre ese color el texto va blanco o negro
  const lum = (hex: string) =>
    rgb(hex)
      .map((v) => v / 255)
      .map((v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)))
      .reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0);
  const onColor = (hex: string) => (lum(hex) > 0.42 ? "#0B0C0E" : "#FFFFFF");
  const mix = (hex: string, t: number) => {
    const to = t < 0 ? 0 : 255;
    const a = Math.abs(t);
    const [r, g, b] = rgb(hex).map((v) => Math.round(v + (to - v) * a));
    return `rgb(${r},${g},${b})`;
  };
  // Azar con semilla: la textura del papel no cambia en cada redibujado

  // Medidas en pulgadas, escritas como en la imprenta: 8-1/2 in
  const fmtIn = (v: number) => {
    const whole = Math.floor(v);
    const fr = +(v - whole).toFixed(3);
    const frac: Record<string, string> = {
      "0.25": "-1/4", "0.5": "-1/2", "0.75": "-3/4",
    };
    const f = frac[String(fr)];
    if (f) return `${whole}${f}`;
    return fr ? String(+v.toFixed(2)) : String(whole);
  };

  const FAMS: Record<string, { title: string; body: string; track: string }> = {
    moderna: { title: '800 {px}px "Saira", "Arial Narrow", sans-serif', body: '500 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
    clasica: { title: '700 {px}px "Playfair Display", Georgia, serif', body: '400 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
    tecnica: { title: '400 {px}px "Michroma", "Eurostile", sans-serif', body: '500 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.02em" },
    sencilla: { title: '600 {px}px "Instrument Sans", system-ui, sans-serif', body: '400 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
  };
  const LABEL = (px: number) => `400 ${px}px "Michroma", "Eurostile", sans-serif`;
  const setTrack = (c: CanvasRenderingContext2D, v: string) => {
    (c as unknown as { letterSpacing: string }).letterSpacing = v;
  };

  // data-carta, no data-menu: el encabezado ya usa data-menu para su navegación
  const root = document.querySelector<HTMLElement>("[data-carta]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const cfg: Cfg = JSON.parse(root.dataset.cfg!);
    const form = root.querySelector<HTMLFormElement>(".nb__panel")!;
    const canvas = root.querySelector<HTMLCanvasElement>(".nb__canvas")!;
    const ctx = canvas.getContext("2d")!;
    const guidesBtn = root.querySelector<HTMLButtonElement>("[data-guides]")!;
    const zoneBtn = root.querySelector<HTMLButtonElement>("[data-zone]")!;
    const viewBtn = root.querySelector<HTMLButtonElement>("[data-view]")!;
    const tools = root.querySelector<HTMLElement>(".nb__tools")!;
    const approx = root.querySelector<HTMLElement>("[data-approx]")!;
    const sizeOut = form.querySelector<HTMLElement>("[data-size-out]")!;
    const shapeHelp = form.querySelector<HTMLElement>("[data-shape-help]")!;
    const lamHelp = form.querySelector<HTMLElement>("[data-lam-help]")!;
    const sideHelp = form.querySelector<HTMLElement>("[data-side-help]")!;
    const imageSeg = form.querySelector<HTMLElement>("[data-image]")!;
    const backSeg = form.querySelector<HTMLElement>("[data-back]")!;
    const backHelp = form.querySelector<HTMLElement>("[data-back-help]")!;
    const accentName = form.querySelector<HTMLElement>("[data-accent-name]")!;
    const qtyEl = form.querySelector<HTMLInputElement>("input[name='cantidad']")!;
    const waEl = form.querySelector<HTMLAnchorElement>("[data-wa]")!;
    const contactBox = form.querySelector<HTMLElement>(".nb__contact")!;

    let guides = false;
    let zone = false;
    const VIEWS = ["ambas", "frente", "reverso"] as const;
    let view: (typeof VIEWS)[number] = "ambas";
    let touched = false; // la dirección cambia solo cuando el cliente toca algo

    const val = (name: string) => (form.elements.namedItem(name) as RadioNodeList).value;
    const text = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value.trim();
    const setRadio = (name: string, v: string | null) => {
      if (!v) return;
      const input = form.querySelector<HTMLInputElement>(`input[name='${name}'][value='${CSS.escape(v)}']`);
      if (input) input.checked = true;
    };
    const stock = () => cfg.stocks.find((s) => s.id === val("papel")) ?? cfg.stocks[0];
    const accent = () => cfg.accents.find((a) => a.id === val("acento")) ?? cfg.accents[0];
    const lam = () => val("laminado");
    const twoSided = () => val("caras") === "dos";
    const hasPhoto = () => val("plantilla") === "foto";
    const qty = () => Math.max(50, Math.min(100000, Math.round(Number(qtyEl.value) || 50)));
    const dims = () => SHAPES[val("formato")] ?? SHAPES.carta;
    const texts = () => ({
      negocio: text("negocio"),
      lema: text("lema"),
      nota: text("nota"),
      tel: text("tel"),
      web: text("web"),
      direccion: text("direccion"),
    });
    const section = (n: 1 | 2): Section => ({
      title: text(`seccion${n}`),
      rows: (n === 1 ? [1, 2, 3] : [4, 5, 6])
        .map((i) => ({ dish: text(`plato${i}`), price: text(`precio${i}`) }))
        .filter((r) => r.dish),
    });

    // ---------- Estado en la dirección: el diseño se puede compartir ----------
    const RADIOS = ["formato", "papel", "laminado", "caras", "plantilla", "fondo", "tipografia", "acento", "imagen", "reverso"];
    const FIELDS: Array<[string, number]> = [
      ["negocio", 28],
      ["lema", 34],
      ["seccion1", 22],
      ["plato1", 28],
      ["precio1", 8],
      ["plato2", 28],
      ["precio2", 8],
      ["plato3", 28],
      ["precio3", 8],
      ["seccion2", 22],
      ["plato4", 28],
      ["precio4", 8],
      ["plato5", 28],
      ["precio5", 8],
      ["plato6", 28],
      ["precio6", 8],
      ["nota", 50],
      ["tel", 24],
      ["web", 30],
      ["direccion", 40],
    ];
    const params = new URLSearchParams(location.search);
    if (params.has("plantilla") && params.has("formato")) {
      RADIOS.forEach((n) => setRadio(n, params.get(n)));
      FIELDS.forEach(([n, max]) => {
        const v = params.get(n);
        if (v !== null) (form.elements.namedItem(n) as HTMLInputElement).value = v.slice(0, max);
      });
      const q = Number(params.get("cantidad"));
      if (q >= 25 && q <= 100000) qtyEl.value = String(Math.round(q));
    }
    const shareUrl = () => {
      const p = new URLSearchParams();
      RADIOS.forEach((n) => p.set(n, val(n)));
      FIELDS.forEach(([n]) => p.set(n, text(n)));
      p.set("cantidad", String(qty()));
      return `${location.origin}${location.pathname}?${p}#disena`;
    };
    let urlTimer = 0;
    const syncUrl = () => {
      clearTimeout(urlTimer);
      urlTimer = window.setTimeout(() => history.replaceState(null, "", shareUrl()), 400);
    };

    // ---------- Dibujo ----------
    // Textura del papel. El laminado brillante levanta un reflejo encima.
    const paper = (c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, st: Stock, s: number) => {
      c.fillStyle = st.base;
      c.fillRect(x, y, w, h);
      if (st.tex === "brillo") {
        const g = c.createLinearGradient(x, y + h, x + w, y);
        g.addColorStop(0, "rgba(255,255,255,0)");
        g.addColorStop(0.44, "rgba(255,255,255,0)");
        g.addColorStop(0.5, "rgba(255,255,255,0.45)");
        g.addColorStop(0.56, "rgba(255,255,255,0)");
        g.addColorStop(1, "rgba(180,200,215,0.14)");
        c.fillStyle = g;
        c.fillRect(x, y, w, h);
      }
      const sh = c.createLinearGradient(x, y, x, y + h);
      sh.addColorStop(0, "rgba(255,255,255,0.12)");
      sh.addColorStop(0.5, "rgba(255,255,255,0)");
      sh.addColorStop(1, "rgba(11,12,14,0.06)");
      c.fillStyle = sh;
      c.fillRect(x, y, w, h);
    };

    // Dibuja una plana del menú
    const drawFace = (c: CanvasRenderingContext2D, x0: number, y0: number, s: number, o: Face, back: string | null) => {
      const { w, h } = o;
      const X = (v: number) => x0 + v * s;
      const Y = (v: number) => y0 + v * s;
      const P = (v: number) => v * s;
      const st = o.stock;
      const acc = o.accent;
      const fu = w; // en una plana manda el ancho
      const m = 0.085 * fu;
      const V = (k: number) => k * h;
      const chalk = o.tpl === "pizarra";

      // ---- Fondo ----
      paper(c, X(0), Y(0), P(w), P(h), st, s);
      const dark = o.bg === "oscuro" || chalk;
      const colored = o.bg === "color" && !chalk;
      if (dark || colored) {
        c.fillStyle = chalk ? "#1E2228" : dark ? "#14161A" : acc;
        c.fillRect(X(0), Y(0), P(w), P(h));
        c.save();
        c.globalAlpha = chalk ? 0.2 : 0.12;
        c.globalCompositeOperation = "overlay";
        paper(c, X(0), Y(0), P(w), P(h), st, s);
        c.restore();
      }
      const ink = dark ? (chalk ? "#F4F1E8" : "#FFFFFF") : colored ? onColor(acc) : st.ink;
      const sub = dark ? (chalk ? "#B9B3A4" : "#AEB5BD") : colored ? mix(onColor(acc), onColor(acc) === "#FFFFFF" ? -0.2 : 0.35) : st.sub;
      const mark = chalk ? mix(acc, 0.45) : colored ? ink : acc;
      const rule = dark ? "rgba(255,255,255,0.28)" : colored ? "rgba(255,255,255,0.45)" : "rgba(11,12,14,0.2)";

      const fam = () => FAMS[o.type] ?? FAMS.moderna;
      const make = (kind: "title" | "body" | "label", px: number) =>
        kind === "label" ? LABEL(px) : fam()[kind].replace("{px}", String(px));

      // Un renglón de texto; en las miniaturas se sustituye por una barra
      const put = (
        txt: string,
        kind: "title" | "body" | "label",
        sizeIn: number,
        xIn: number,
        yIn: number,
        maxIn: number,
        color: string,
        align: CanvasTextAlign = "left",
        upper = false
      ) => {
        if (!txt) return 0;
        const px = Math.max(1, P(sizeIn));
        const maxPx = P(maxIn);
        const t = upper ? txt.toLocaleUpperCase() : txt;
        setTrack(c, kind === "label" ? "0.1em" : fam().track);
        c.font = make(kind, px);
        let wd = c.measureText(t).width;
        if (wd > maxPx && wd > 0) {
          c.font = make(kind, px * (maxPx / wd));
          wd = maxPx;
        }
        c.fillStyle = color;
        c.textAlign = align;
        c.textBaseline = "alphabetic";
        if (o.mini) {
          const bh = Math.max(1, px * 0.58);
          const bx = align === "right" ? X(xIn) - wd : align === "center" ? X(xIn) - wd / 2 : X(xIn);
          c.fillRect(bx, Y(yIn) - bh, wd, bh);
        } else {
          c.fillText(t, X(xIn), Y(yIn));
        }
        setTrack(c, "0px");
        return wd / s;
      };

      // Un filete horizontal, de x1 a x2 a la altura y
      const line = (x1: number, y: number, x2: number, color = rule, lw = 1) => {
        c.strokeStyle = color;
        c.lineWidth = Math.max(1, lw);
        c.beginPath();
        c.moveTo(X(x1), Y(y));
        c.lineTo(X(x2), Y(y));
        c.stroke();
      };
      // Hueco de la foto: rayado en diagonal con su rótulo, o un bloque de color
      const image = (xIn: number, yIn: number, wIn: number, hIn: number) => {
        const ix = X(xIn);
        const iy = Y(yIn);
        const iw = P(wIn);
        const ih = P(hIn);
        if (!o.photo) {
          c.fillStyle = mark;
          c.fillRect(ix, iy, iw, ih);
          return;
        }
        c.save();
        c.beginPath();
        c.rect(ix, iy, iw, ih);
        c.clip();
        c.fillStyle = dark ? "#2A2E34" : colored ? mix(acc, onColor(acc) === "#FFFFFF" ? -0.18 : 0.2) : "#E4E7EA";
        c.fillRect(ix, iy, iw, ih);
        c.strokeStyle = dark ? "rgba(255,255,255,0.1)" : "rgba(11,12,14,0.09)";
        c.lineWidth = Math.max(1, P(0.02));
        const step = Math.max(6, P(0.3));
        c.beginPath();
        for (let i = -ih; i < iw; i += step) {
          c.moveTo(ix + i, iy + ih);
          c.lineTo(ix + i + ih, iy);
        }
        c.stroke();
        c.restore();
        if (!o.mini) {
          const lbl = Math.min(hIn * 0.11, wIn * 0.055);
          put(cfg.copy.photoBox, "label", lbl, xIn + wIn / 2, yIn + hIn / 2 + lbl * 0.4, wIn * 0.7, dark ? "#8D949C" : colored ? sub : "#8A9099", "center");
        }
      };

      // El renglón del menú: plato a la izquierda, precio a la derecha y la
      // fila de puntos que los une, que es lo que hace que un menú parezca menú
      const dishRow = (dish: string, price: string, xIn: number, yIn: number, wIn: number, sizeIn: number, leaders: boolean) => {
        const nameW = put(dish, "body", sizeIn, xIn, yIn, wIn * 0.78, ink);
        if (!price) return;
        setTrack(c, fam().track);
        c.font = make("body", Math.max(1, P(sizeIn)));
        const priceW = c.measureText(price).width / s;
        put(price, "body", sizeIn, xIn + wIn, yIn, wIn * 0.22, mark, "right");
        setTrack(c, "0px");
        if (!leaders || o.mini) return;
        const from = xIn + nameW + sizeIn * 0.4;
        const to = xIn + wIn - priceW - sizeIn * 0.4;
        if (to <= from) return;
        c.save();
        c.strokeStyle = rule;
        c.lineWidth = 1;
        c.setLineDash([1, Math.max(2, P(0.05))]);
        c.lineCap = "round";
        c.beginPath();
        c.moveTo(X(from), Y(yIn - sizeIn * 0.12));
        c.lineTo(X(to), Y(yIn - sizeIn * 0.12));
        c.stroke();
        c.restore();
      };

      // Las listas, repartidas en la banda que les toca
      const lists = (secs: Section[], xIn: number, topIn: number, wIn: number, hIn: number, opts: { center?: boolean; leaders?: boolean; caps?: boolean }) => {
        const rows = secs.reduce((a, s2) => a + s2.rows.length, 0);
        if (!rows && !secs.length) return;
        const units = secs.length * 2.1 + rows; // el título pesa como dos renglones
        const step = hIn / Math.max(1, units + 0.6);
        const size = Math.min(step * 0.52, wIn * 0.045);
        let y = topIn + step;
        secs.forEach((sec, si) => {
          if (si) y += step * 0.5;
          if (sec.title) {
            put(sec.title, opts.caps ? "label" : "title", size * 1.12, opts.center ? xIn + wIn / 2 : xIn, y, wIn, mark, opts.center ? "center" : "left", opts.caps);
            line(xIn, y + size * 0.5, xIn + wIn);
            y += step * 1.5;
          }
          sec.rows.forEach((r) => {
            dishRow(r.dish, r.price, xIn, y, wIn, size, opts.leaders !== false);
            y += step;
          });
        });
      };

      const t = o.t;
      const foot = [t.direccion, t.tel, t.web].filter(Boolean).join("   ·   ");

      // ---- Reverso ----
      if (back && back !== "seccion2") {
        if (back === "logo") {
          if (!colored && !dark) {
            c.fillStyle = acc;
            c.fillRect(X(0), Y(0), P(w), P(h));
          }
          const bgInk = colored || dark ? ink : onColor(acc);
          put(t.negocio, "title", 0.11 * fu, w / 2, V(0.46), w - m * 2, bgInk, "center");
          if (t.lema) put(t.lema, "body", 0.034 * fu, w / 2, V(0.53), w - m * 2, bgInk, "center");
          if (t.tel) put(t.tel, "title", 0.05 * fu, w / 2, V(0.62), w - m * 2, bgInk, "center");
        } else {
          put(t.negocio, "title", 0.085 * fu, w / 2, V(0.16), w - m * 2, ink, "center");
          if (t.lema) put(t.lema, "body", 0.032 * fu, w / 2, V(0.21), w - m * 2, sub, "center");
          line(m, V(0.25), w - m);
          put(cfg.copy.hours, "label", 0.03 * fu, w / 2, V(0.33), w - m * 2, mark, "center");
          put(t.direccion, "body", 0.036 * fu, w / 2, V(0.42), w - m * 2, ink, "center");
          put(t.tel, "title", 0.055 * fu, w / 2, V(0.5), w - m * 2, mark, "center");
          put(t.web, "body", 0.034 * fu, w / 2, V(0.56), w - m * 2, sub, "center");
          if (o.photo) image(m, V(0.64), w - m * 2, h * 0.18);
          put(t.nota, "body", 0.028 * fu, w / 2, V(0.92), w - m * 2, sub, "center");
        }
        return;
      }

      // ---- La plana con las listas ----
      const secs = o.secs;
      if (o.tpl === "clasico") {
        put(t.negocio, "title", 0.082 * fu, w / 2, V(0.1), w - m * 2, ink, "center");
        if (t.lema) put(t.lema, "body", 0.03 * fu, w / 2, V(0.145), w - m * 2, sub, "center");
        line(w / 2 - w * 0.12, V(0.175), w / 2 + w * 0.12, mark, Math.max(1, P(0.012)));
        lists(secs, m, V(0.2), w - m * 2, h * 0.68, { center: true, leaders: true });
        line(m, V(0.9), w - m);
        put(t.nota, "body", 0.026 * fu, w / 2, V(0.94), w - m * 2, sub, "center");
        put(foot, "body", 0.028 * fu, w / 2, V(0.97), w - m * 2, ink, "center");
      } else if (o.tpl === "moderno") {
        c.fillStyle = mark;
        c.fillRect(X(m), Y(V(0.07)), P(w * 0.1), P(0.02 * fu));
        put(t.negocio, "title", 0.1 * fu, m, V(0.14), w - m * 2, ink);
        if (t.lema) put(t.lema, "body", 0.032 * fu, m, V(0.18), w - m * 2, sub);
        lists(secs, m, V(0.22), w - m * 2, h * 0.65, { center: false, leaders: false, caps: true });
        c.fillStyle = mark;
        c.fillRect(X(0), Y(V(0.92)), P(w), P(h * 0.08));
        const onMark = colored ? acc : onColor(acc);
        put(foot, "body", 0.028 * fu, w / 2, V(0.955), w - m * 2, onMark, "center");
        put(t.nota, "body", 0.024 * fu, w / 2, V(0.985), w - m * 2, onMark, "center");
      } else if (o.tpl === "bistro") {
        c.strokeStyle = mark;
        c.lineWidth = Math.max(1, P(0.016));
        c.strokeRect(X(m * 0.6), Y(V(0.035)), P(w - m * 1.2), P(h * 0.93));
        c.lineWidth = 1;
        c.strokeStyle = rule;
        c.strokeRect(X(m * 0.85), Y(V(0.05)), P(w - m * 1.7), P(h * 0.9));
        put(t.lema, "label", 0.028 * fu, w / 2, V(0.11), w - m * 2.4, sub, "center");
        put(t.negocio, "title", 0.09 * fu, w / 2, V(0.17), w - m * 2.4, ink, "center");
        line(w / 2 - w * 0.1, V(0.2), w / 2 + w * 0.1, mark, Math.max(1, P(0.01)));
        lists(secs, m * 1.3, V(0.23), w - m * 2.6, h * 0.6, { center: true, leaders: true });
        put(t.nota, "body", 0.026 * fu, w / 2, V(0.88), w - m * 2.4, sub, "center");
        put(foot, "body", 0.028 * fu, w / 2, V(0.92), w - m * 2.4, ink, "center");
      } else if (o.tpl === "foto") {
        image(0, 0, w, h * 0.26);
        put(t.negocio, "title", 0.085 * fu, w / 2, V(0.35), w - m * 2, ink, "center");
        if (t.lema) put(t.lema, "body", 0.03 * fu, w / 2, V(0.39), w - m * 2, sub, "center");
        lists(secs, m, V(0.42), w - m * 2, h * 0.47, { center: false, leaders: true });
        line(m, V(0.92), w - m);
        put(foot, "body", 0.028 * fu, w / 2, V(0.96), w - m * 2, ink, "center");
      } else {
        // pizarra: el menú del día, como escrito con tiza
        c.strokeStyle = mix(acc, 0.5);
        c.lineWidth = Math.max(1, P(0.014));
        c.strokeRect(X(m * 0.5), Y(V(0.03)), P(w - m), P(h * 0.94));
        put(t.lema, "label", 0.028 * fu, w / 2, V(0.1), w - m * 2, sub, "center", true);
        put(t.negocio, "title", 0.1 * fu, w / 2, V(0.16), w - m * 2, ink, "center");
        line(w / 2 - w * 0.14, V(0.195), w / 2 + w * 0.14, mix(acc, 0.5), Math.max(1, P(0.01)));
        lists(secs, m, V(0.22), w - m * 2, h * 0.62, { center: true, leaders: true, caps: true });
        put(t.nota, "body", 0.026 * fu, w / 2, V(0.9), w - m * 2, sub, "center");
        put(foot, "body", 0.028 * fu, w / 2, V(0.94), w - m * 2, ink, "center");
      }
    };

    // Una plana completa: sombra, papel, diseño, brillo del laminado y guías
    const drawSheet = (x0: number, y0: number, s: number, o: Face, back: string | null) => {
      const wPx = o.w * s;
      const hPx = o.h * s;
      ctx.save();
      ctx.shadowColor = "rgba(18,26,36,0.4)";
      ctx.shadowBlur = 22;
      ctx.shadowOffsetY = 10;
      ctx.fillStyle = o.stock.edge;
      ctx.fillRect(x0, y0, wPx, hPx);
      ctx.restore();

      ctx.save();
      ctx.beginPath();
      ctx.rect(x0, y0, wPx, hPx);
      ctx.clip();
      drawFace(ctx, x0, y0, s, o, back);
      // El laminado brillante se nota en el reflejo de la plana
      if (o.lam === "brillante") {
        const g = ctx.createLinearGradient(x0, y0 + hPx, x0 + wPx, y0);
        g.addColorStop(0, "rgba(255,255,255,0)");
        g.addColorStop(0.46, "rgba(255,255,255,0)");
        g.addColorStop(0.52, "rgba(255,255,255,0.3)");
        g.addColorStop(0.58, "rgba(255,255,255,0)");
        g.addColorStop(1, "rgba(255,255,255,0)");
        ctx.fillStyle = g;
        ctx.fillRect(x0, y0, wPx, hPx);
      }
      ctx.restore();

      ctx.lineWidth = 1;
      ctx.strokeStyle = "rgba(11,12,14,0.26)";
      ctx.strokeRect(x0, y0, wPx, hPx);

      // Dónde se para la vista: lo que marcan los que diseñan menús
      if (zone && !back) {
        const cx = x0 + wPx * 0.68;
        const cy = y0 + hPx * 0.3;
        const rx = wPx * 0.3;
        const ry = hPx * 0.17;
        ctx.save();
        const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(rx, ry));
        g.addColorStop(0, "rgba(255,202,9,0.42)");
        g.addColorStop(0.6, "rgba(255,202,9,0.16)");
        g.addColorStop(1, "rgba(255,202,9,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx * 1.25, ry * 1.3, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = "#E0A800";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
        // El rótulo va en una pastilla: encima del texto impreso no se leería
        ctx.font = `600 11px "Instrument Sans", system-ui, sans-serif`;
        const lw = ctx.measureText(cfg.copy.zoneLbl).width;
        const ly = cy - ry - 8;
        ctx.fillStyle = "rgba(255,255,255,0.94)";
        ctx.strokeStyle = "#E0A800";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(cx - lw / 2 - 7, ly - 15, lw + 14, 19, 9);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = "#7A5C00";
        ctx.textAlign = "center";
        ctx.textBaseline = "alphabetic";
        ctx.fillText(cfg.copy.zoneLbl, cx, ly);
      }

      if (guides) {
        ctx.save();
        ctx.lineWidth = 1;
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = "#ED1B24";
        ctx.strokeRect(x0 - BLEED * s, y0 - BLEED * s, wPx + BLEED * 2 * s, hPx + BLEED * 2 * s);
        ctx.strokeStyle = "#0094DA";
        ctx.strokeRect(x0 + SAFE * s, y0 + SAFE * s, wPx - SAFE * 2 * s, hPx - SAFE * 2 * s);
        ctx.restore();
      }
    };

    // Con una cara las dos listas van juntas; con dos, cada una en su plana
    const facesOf = (back: string | null): Section[] => {
      const s1 = section(1);
      const s2 = section(2);
      if (!twoSided()) return [s1, s2].filter((x) => x.rows.length || x.title);
      if (back) return [s2].filter((x) => x.rows.length || x.title);
      return [s1].filter((x) => x.rows.length || x.title);
    };

    const face = (mini: boolean, tpl?: string, back: string | null = null): Face => ({
      ...dims(),
      stock: stock(),
      accent: accent().hex,
      type: val("tipografia"),
      tpl: tpl ?? val("plantilla"),
      bg: val("fondo"),
      photo: val("imagen") === "foto",
      lam: lam(),
      t: texts(),
      secs: facesOf(back),
      mini,
    });

    const draw = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const cw = canvas.clientWidth;
      const ch = canvas.clientHeight;
      if (!cw || !ch) return;
      if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) {
        canvas.width = Math.round(cw * dpr);
        canvas.height = Math.round(ch * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cw, ch);

      const { w, h } = dims();
      const two = twoSided();
      const faces: Array<string | null> = !two ? [null] : view === "frente" ? [null] : view === "reverso" ? [val("reverso")] : [null, val("reverso")];
      const n = faces.length;
      const top = tools.offsetHeight + 24;
      const keep = top + 54 + (approx.offsetParent ? 34 : 0);
      const gap = w * 0.22;
      const pad = guides ? 0.35 : 0.06;
      // Dos planas: se prueba una al lado de otra y una debajo de otra
      const fit = (cols: number, rows: number) =>
        Math.min((cw - 44) / (w * cols + gap * (cols - 1) + pad * 2), (ch - keep - (rows > 1 ? 26 : 0)) / (h * rows + gap * (rows - 1) + pad * 2));
      const side = fit(n, 1);
      const stack = n > 1 ? fit(1, n) : side;
      const rows = stack > side ? n : 1;
      const cols = rows === 1 ? n : 1;
      const s = Math.max(side, stack);
      const groupW = w * cols + gap * (cols - 1);
      const groupH = h * rows + gap * (rows - 1);
      const x0 = (cw - groupW * s) / 2;
      const y0 = Math.max(top, 16 + (ch - groupH * s - 54) / 2);
      const at = (i: number) => ({
        x: x0 + (cols > 1 ? i * (w + gap) * s : 0),
        y: y0 + (rows > 1 ? i * (h + gap) * s : 0),
      });

      faces.forEach((back, i) => {
        const p = at(i);
        drawSheet(p.x, p.y, s, face(false, undefined, back), back);
      });

      // Rótulo de cada plana, debajo
      if (n > 1 || view !== "ambas") {
        ctx.fillStyle = "rgba(11,12,14,0.6)";
        ctx.font = `600 12px "Instrument Sans", system-ui, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        faces.forEach((back, i) => {
          const p = at(i);
          ctx.fillText(back ? cfg.copy.backLbl : cfg.copy.front, p.x + (w * s) / 2, p.y + h * s + 7);
        });
      }

      // Cota del ancho, debajo del grupo
      const gy = y0 + groupH * s + (n > 1 || view !== "ambas" ? 30 : 20);
      const tick = 5;
      ctx.strokeStyle = "rgba(11,12,14,0.5)";
      ctx.fillStyle = "rgba(11,12,14,0.66)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x0, gy);
      ctx.lineTo(x0 + w * s, gy);
      ctx.moveTo(x0, gy - tick);
      ctx.lineTo(x0, gy + tick);
      ctx.moveTo(x0 + w * s, gy - tick);
      ctx.lineTo(x0 + w * s, gy + tick);
      ctx.stroke();
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      ctx.font = `500 12px "Instrument Sans", system-ui, sans-serif`;
      const lamTxt = lam() === "ninguno" ? "" : ` · ${cfg.lams[lam()]}`;
      const txt = `${fmtIn(w)} × ${fmtIn(h)} in · ${stock().name}${lamTxt}`;
      const half = ctx.measureText(txt).width / 2;
      ctx.fillText(txt, Math.min(Math.max(x0 + (w * s) / 2, half + 8), cw - half - 8), gy + 7);

      canvas.setAttribute(
        "aria-label",
        `${cfg.copy.preview}: ${fmtIn(w)} × ${fmtIn(h)} in · ${stock().name} · ${cfg.tpls[val("plantilla")]} · ${accent().name}${texts().negocio ? ` · "${texts().negocio}"` : ""}`
      );
    };

    // Miniaturas de los diseños, con el mismo dibujo que la vista previa
    const renderTpls = () => {
      const ids = Object.keys(cfg.tpls);
      form.querySelectorAll<HTMLCanvasElement>(".mn__tpl canvas").forEach((cv, i) => {
        const c2 = cv.getContext("2d")!;
        const o: Face = { ...face(true, ids[i] ?? ids[0]), w: 8.5, h: 11 };
        c2.setTransform(1, 0, 0, 1, 0, 0);
        c2.clearRect(0, 0, cv.width, cv.height);
        const s = Math.min((cv.width - 10) / o.w, (cv.height - 10) / o.h);
        const x = (cv.width - o.w * s) / 2;
        const y = (cv.height - o.h * s) / 2;
        c2.save();
        c2.beginPath();
        c2.rect(x, y, o.w * s, o.h * s);
        c2.clip();
        drawFace(c2, x, y, s, o, null);
        c2.restore();
        c2.lineWidth = 1;
        c2.strokeStyle = "rgba(11,12,14,0.22)";
        c2.strokeRect(x, y, o.w * s, o.h * s);
      });
    };

    // ---------- Resumen para la cotización ----------
    const summary = () => {
      const k = cfg.copy;
      const { w, h } = dims();
      const t = texts();
      const listOf = (sec: { title: string; rows: Array<{ dish: string; price: string }> }) =>
        sec.rows.length ? `${sec.title}: ${sec.rows.map((r) => `${r.dish}${r.price ? ` ${r.price}` : ""}`).join(", ")}` : "";
      const menu = [listOf(section(1)), listOf(section(2))].filter(Boolean).join(" / ");
      const out = [
        `${k.summary}:`,
        `• ${k.sFormat}: ${cfg.shapes[val("formato")]} ${fmtIn(w)} × ${fmtIn(h)} in`,
        `• ${k.sPaper}: ${stock().name}`,
        `• ${k.sLam}: ${cfg.lams[lam()]}`,
        `• ${k.sSides}: ${cfg.sides[val("caras")]}`,
        `• ${k.sDesign}: ${cfg.tpls[val("plantilla")]}`,
        `• ${k.sBg}: ${cfg.bgs[val("fondo")]}`,
        `• ${k.sType}: ${cfg.types[val("tipografia")]}`,
        `• ${k.sAccent}: ${accent().name}`,
      ];
      if (hasPhoto()) out.push(`• ${k.sImage}: ${cfg.images[val("imagen")]}`);
      out.push(`• ${k.sName}: ${[t.negocio, t.lema].filter(Boolean).join(" · ")}`, `• ${k.sMenu}: ${menu}`);
      if (t.nota) out.push(`• ${k.sNote}: "${t.nota}"`);
      out.push(`• ${k.sBiz}: ${[t.direccion, t.tel, t.web].filter(Boolean).join(" / ")}`);
      if (twoSided()) out.push(`• ${k.sBack}: ${cfg.backs[val("reverso")]}`);
      out.push(`• ${k.sQty}: ${qty()}`, `• ${k.sLink}: ${shareUrl()}`);
      return out.join("\n");
    };

    const syncUI = () => {
      const { w, h } = dims();
      lamHelp.textContent = cfg.lamHelp[val("laminado")] ?? "";
      imageSeg.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !hasPhoto()));
      imageSeg.toggleAttribute("data-off", !hasPhoto());
      backSeg.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !twoSided()));
      backSeg.toggleAttribute("data-off", !twoSided());
      backHelp.hidden = twoSided();
      sideHelp.textContent = cfg.sideHelp[val("caras")] ?? "";
      shapeHelp.textContent = cfg.shapeHelp[val("formato")] ?? "";
      accentName.textContent = accent().name;
      sizeOut.textContent = `${fmtIn(w)} × ${fmtIn(h)} in`;
      approx.textContent = guides ? cfg.copy.guidesOn : zone ? cfg.copy.zoneOn : cfg.copy.approx;
      guidesBtn.setAttribute("aria-pressed", String(guides));
      zoneBtn.setAttribute("aria-pressed", String(zone));
      viewBtn.textContent = cfg.views[view];
      viewBtn.hidden = !twoSided();
      const q = qty();
      root.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.qty) === q)));
    };
    const update = () => {
      waEl.href = `https://wa.me/${cfg.phone}?text=${encodeURIComponent(`${cfg.copy.waIntro}\n\n${summary()}`)}`;
      if (touched) syncUrl();
    };
    const render = () => {
      syncUI();
      draw();
      renderTpls();
      update();
    };

    // ---------- Eventos ----------
    const onEdit = (e: Event) => {
      if (contactBox.contains(e.target as Node)) return;
      touched = true;
      render();
    };
    form.addEventListener("change", onEdit);
    form.addEventListener("input", onEdit);
    root.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) =>
      b.addEventListener("click", () => {
        qtyEl.value = b.dataset.qty!;
        touched = true;
        render();
      })
    );
    guidesBtn.addEventListener("click", () => {
      guides = !guides;
      syncUI();
      draw();
    });
    zoneBtn.addEventListener("click", () => {
      zone = !zone;
      syncUI();
      draw();
    });
    viewBtn.addEventListener("click", () => {
      view = VIEWS[(VIEWS.indexOf(view) + 1) % VIEWS.length];
      syncUI();
      draw();
    });

    wireQuote(form, { formValue: cfg.formValue, lang: cfg.lang, summary });

    new ResizeObserver(() => draw()).observe(canvas);
    Promise.all(
      [`800 40px "Saira"`, `700 40px "Playfair Display"`, `400 40px "Michroma"`, `500 40px "Instrument Sans"`].map((f) =>
        document.fonts.load(f).catch(() => [])
      )
    ).then(() => render());
    render();
  }
</script>
