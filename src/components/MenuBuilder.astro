---
// Constructor de menús. La idea viene de los menús de Vistaprint, pero las
// opciones son las del taller, confirmadas por el dueño: carta y largo, mate y
// brillante, desde 50, y el laminado brillante o mate, que el dueño confirmó el
// 2026-10-14. El laminado es lo único que aquí aguanta la salsa, así que es el
// argumento del producto: Vistaprint no lo ofrece en menús (su opción lavable es
// el papel sintético, que el taller no tiene), y este taller sí. Lo propio de
// este producto son los renglones de plato y precio y dónde se para la vista
// del cliente: el constructor marca esa zona. No muestra precios de imprenta:
// el precio de la impresión va en la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import { SERVICES, serviceUrl } from "../data/catalog";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Los dos papeles del taller.
const STOCKS = [
  { id: "brillante", es: "Brillante", en: "Glossy", base: "#FFFFFF", edge: "#E4E8EB", ink: "#14161A", sub: "#5A616B", tex: "brillo",
    sw: "linear-gradient(118deg, #FFF 0 26%, #D8E2EA 44%, #FFF 62%, #EDF1F4)" },
  { id: "mate", es: "Mate", en: "Matte", base: "#FFFFFF", edge: "#E7E8E6", ink: "#14161A", sub: "#5A616B", tex: "mate",
    sw: "linear-gradient(135deg, #FFF 0 52%, #EFF0EE)" },
];

// La paleta LED del logo más neutros de imprenta
const ACCENTS = [
  { id: "vino", es: "Vino", en: "Wine", hex: "#7A1F2B" },
  { id: "oliva", es: "Verde oliva", en: "Olive", hex: "#4F5B32" },
  { id: "terracota", es: "Terracota", en: "Terracotta", hex: "#B4522E" },
  { id: "marino", es: "Azul marino", en: "Navy", hex: "#16304F" },
  { id: "negro", es: "Negro", en: "Black", hex: "#0B0C0E" },
  { id: "pizarra", es: "Gris pizarra", en: "Slate grey", hex: "#59626D" },
  { id: "azul", es: "Azul LED", en: "LED blue", hex: "#0094DA" },
  { id: "amarillo", es: "Amarillo LED", en: "LED yellow", hex: "#FFCA09" },
  { id: "verde", es: "Verde LED", en: "LED green", hex: "#99C941" },
  { id: "rojo", es: "Rojo LED", en: "LED red", hex: "#ED1B24" },
];

const QTYS = [50, 100, 250, 500];

