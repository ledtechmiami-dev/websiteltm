---
// Constructor de tarjetas de exhibidor (idea tomada del estudio de diseño de
// Vistaprint, que las hace de 3.74 × 8.27 in en 13 papeles, con esquinas rectas
// o redondeadas, una o dos caras, lámina de acento, barniz realzado y talón
// perforado). Lo propio de este producto es el exhibidor: en un mostrador de
// varios niveles solo se ve la parte de arriba, y el constructor lo enseña.
// El dueño confirmó papeles, acabados y esquinas tal como están; la
// perforación del talón, en cambio, la hace un taller aliado y suma días.
// No muestra precios: el precio va en la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Un surtido de los papeles del oficio. tex: cómo se dibuja en la vista previa.
const STOCKS = [
  { id: "brillante", es: "Brillante", en: "Glossy", base: "#FFFFFF", edge: "#E4E8EB", ink: "#14161A", sub: "#5A616B", tex: "brillo",
    sw: "linear-gradient(118deg, #FFF 0 26%, #D8E2EA 44%, #FFF 62%, #EDF1F4)" },
  { id: "mate", es: "Mate", en: "Matte", base: "#FFFFFF", edge: "#E7E8E6", ink: "#14161A", sub: "#5A616B", tex: "mate",
    sw: "linear-gradient(135deg, #FFF 0 52%, #EFF0EE)" },
  { id: "natural", es: "Sin recubrir", en: "Uncoated", base: "#FAF8F3", edge: "#E6E1D6", ink: "#1A1A18", sub: "#5E5B52", tex: "fibra",
    sw: "linear-gradient(135deg, #FBF9F4, #EBE5D9)" },
  { id: "reciclado", es: "Reciclado", en: "Recycled", base: "#F0ECE2", edge: "#D9D3C4", ink: "#1E1C17", sub: "#60594B", tex: "reciclado",
    sw: "linear-gradient(135deg, #F2EEE4, #DED8C9)" },
  { id: "lino", es: "Lino", en: "Linen", base: "#FBFAF7", edge: "#E6E3DB", ink: "#16171A", sub: "#5C5F66", tex: "lino",
    sw: "repeating-linear-gradient(90deg, #FBFAF7 0 2px, #EFEDE7 2px 3px), repeating-linear-gradient(0deg, #FBFAF7 0 2px, #F2F0EA 2px 3px)" },
  { id: "perlado", es: "Perlado", en: "Pearl", base: "#FDFCFA", edge: "#E8E4DF", ink: "#15161A", sub: "#5B5E66", tex: "perla",
    sw: "linear-gradient(118deg, #FFFDF8 0 30%, #EDE6DC 48%, #FFFEFA 66%, #F3EDE4)" },
];

// La paleta LED del logo más neutros de imprenta
const ACCENTS = [
  { id: "azul", es: "Azul LED", en: "LED blue", hex: "#0094DA" },
  { id: "amarillo", es: "Amarillo LED", en: "LED yellow", hex: "#FFCA09" },
  { id: "verde", es: "Verde LED", en: "LED green", hex: "#99C941" },
  { id: "rojo", es: "Rojo LED", en: "LED red", hex: "#ED1B24" },
  { id: "negro", es: "Negro", en: "Black", hex: "#0B0C0E" },
  { id: "pizarra", es: "Gris pizarra", en: "Slate grey", hex: "#59626D" },
  { id: "marino", es: "Azul marino", en: "Navy", hex: "#16304F" },
  { id: "vino", es: "Vino", en: "Wine", hex: "#7A1F2B" },
  { id: "oliva", es: "Verde oliva", en: "Olive", hex: "#4F5B32" },
  { id: "terracota", es: "Terracota", en: "Terracotta", hex: "#B4522E" },
