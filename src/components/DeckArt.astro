---
// Cubierta de un bote de consola central vista desde arriba, para el antes y después
// de pisos EVA mientras no haya fotos reales. foam=false: fibra de vidrio pelada;
// foam=true: la misma cubierta con EVA gris de ranuras claras.
// Usa la misma geometría que el diagrama del constructor (EvaBuilder).
interface Props {
  foam?: boolean;
}

const { foam = false } = Astro.props;
const uid = `d${Math.random().toString(36).slice(2, 7)}`;

const rr = (x: number, y: number, w: number, h: number, r: number) =>
  `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}` +
  `H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
const rect = (x: number, y: number, w: number, h: number) => `M${x} ${y}H${x + w}V${y + h}H${x}Z`;

const HULL = "M0 -170H560C800 -170 940 -100 1000 0C940 100 800 170 560 170H0Z";
const DECK = "M18 -150H560C780 -150 915 -88 972 0C915 88 780 150 560 150H18Z";
const PLATFORM = rr(-84, -146, 80, 292, 16);
const CONSOLE = rr(470, -78, 120, 156, 14);
const POST = rr(355, -60, 50, 120, 12);
const COOLER = rr(630, -52, 78, 104, 12);
const COOLER_TOP = rr(637, -45, 64, 90, 9);
const HATCHES = [rr(40, -124, 112, 84, 10), rr(40, 40, 112, 84, 10), rr(192, -58, 128, 116, 12), rr(776, -44, 92, 88, 22)];

const G = 3; // ranura
const M = 9; // borde liso de cada pieza
const FOAM = "#8E959C";
const GROOVE = "#D3D8DC";
const FIBER = "#F2F4F5";
const INK = "#0B0C0E";

// Piezas de EVA; las tapas, la consola, el asiento y la nevera quedan como huecos
const PIECES = [
  { d: rr(-78, -138, 66, 276, 12), deck: false },
  { d: rect(10, -160, 340, 320) + HATCHES[0] + HATCHES[1] + HATCHES[2], deck: true },
  { d: rect(350, -160, 260, 320) + CONSOLE + POST, deck: true },
  { d: rect(610, -160, 400, 320) + COOLER + HATCHES[3], deck: true },
  ...HATCHES.map((d) => ({ d, deck: false })),
];
const TOP = PIECES.length; // índice del recorte de la tapa de la nevera
---
<svg class="deck-art" viewBox="0 0 480 360" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={`${uid}-deck`}><path d={DECK} /></clipPath>
    {foam && PIECES.map((p, i) => <clipPath id={`${uid}-p${i}`}><path d={p.d} clip-rule="evenodd" /></clipPath>)}
    {foam && <clipPath id={`${uid}-p${TOP}`}><path d={COOLER_TOP} /></clipPath>}
    {foam && (
      <pattern id={`${uid}-teak`} width="40" height="15" patternUnits="userSpaceOnUse">
        <rect width="40" height="15" fill={FOAM} />
        <rect y="6" width="40" height={G} fill={GROOVE} />
      </pattern>
    )}
  </defs>

  <g fill="none" stroke="#0094DA" stroke-opacity="0.3" stroke-width="2" stroke-linecap="round">
    <path d="M28 70q10-5 20 0t20 0" />
    <path d="M392 58q10-5 20 0t20 0 20 0" />
    <path d="M50 300q10-5 20 0t20 0 20 0" />
    <path d="M372 304q10-5 20 0t20 0" />
    <path d="M206 332q10-5 20 0t20 0 20 0" />
  </g>

  <g transform="translate(240 184) rotate(-14) scale(0.4) translate(-458 0)">
    <path d={HULL} transform="translate(16 26)" fill={INK} opacity="0.12" />
    <rect x="-128" y="-30" width="40" height="60" rx="10" fill={INK} />
    <path d={HULL} fill="#fff" />
    <path d={PLATFORM} fill="#fff" stroke={INK} stroke-width="5" />
    <path d={DECK} fill={FIBER} />

    {foam ? (
      PIECES.map((p, i) => (
        <g clip-path={p.deck ? `url(#${uid}-deck)` : undefined}>
          <g clip-path={`url(#${uid}-p${i})`}>
            <rect x="-140" y="-180" width="1160" height="360" fill={`url(#${uid}-teak)`} />
            <path d={p.deck ? p.d + DECK : p.d} fill="none" stroke={GROOVE} stroke-width={2 * (M + G)} />
            <path d={p.deck ? p.d + DECK : p.d} fill="none" stroke={FOAM} stroke-width={2 * M} />
          </g>
        </g>
      ))
    ) : (
      <g>
        {HATCHES.map((d) => <path d={d} fill="#F8F9FA" stroke="#B4BCC3" stroke-width="4" />)}
        <g fill="#B4BCC3">
          <rect x="46" y="-112" width="6" height="16" rx="2" />
          <rect x="46" y="-66" width="6" height="16" rx="2" />
          <rect x="46" y="52" width="6" height="16" rx="2" />
          <rect x="46" y="98" width="6" height="16" rx="2" />
          <rect x="198" y="-40" width="6" height="16" rx="2" />
          <rect x="198" y="24" width="6" height="16" rx="2" />
          <ellipse cx="822" cy="0" rx="12" ry="5" />
        </g>
        <g fill="#8C959E" opacity="0.18">
          <ellipse cx="250" cy="118" rx="46" ry="12" />
          <ellipse cx="700" cy="98" rx="36" ry="9" />
          <ellipse cx="410" cy="-120" rx="30" ry="8" />
        </g>
      </g>
    )}

    <path d={DECK} fill="none" stroke={INK} stroke-opacity="0.35" stroke-width="2.5" />
    <path d={HULL} fill="none" stroke={INK} stroke-width="5" stroke-linejoin="round" />

    <path d={CONSOLE} fill="#fff" stroke={INK} stroke-width="4" />
    <path d={rr(572, -66, 14, 132, 6)} fill="#CFE3EE" stroke={INK} stroke-width="3" />
    <circle cx="494" cy="-24" r="15" fill="none" stroke={INK} stroke-width="5" />
    <path d={POST} fill="#fff" stroke={INK} stroke-width="4" />
    <path d={rr(362, -50, 36, 100, 8)} fill="#59626D" />
    <path d={COOLER} fill="#fff" stroke={INK} stroke-width="4" />
    {foam && (
      <g clip-path={`url(#${uid}-p${TOP})`}>
        <rect x="630" y="-52" width="78" height="104" fill={`url(#${uid}-teak)`} />
        <path d={COOLER_TOP} fill="none" stroke={GROOVE} stroke-width={2 * (M + G)} />
        <path d={COOLER_TOP} fill="none" stroke={FOAM} stroke-width={2 * M} />
      </g>
    )}
  </g>
</svg>
