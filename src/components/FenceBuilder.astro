---
// Constructor de cercas de aluminio: el cliente elige el alto (4, 5 o 6 ft), el largo
// total, el grosor de los postes y de qué va cada tablilla del panel. Las tablillas van
// horizontales, con las medidas que fabrica el taller, y pueden combinarse dentro del
// mismo panel: aluminio, PVC decorativo, acrílico o acrílico con luz LED. Se pueden
// agregar y quitar tablillas; el espacio que sobra se reparte como separación. El diseño
// del panel se repite en toda la cerca. También elige el color del aluminio (incluida la
// simulación de madera), el color del PVC y si los topes de los postes van iluminados.
// Ve la cerca de día y de noche con sus medidas y manda el diseño al correo. Sin precios.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

const HEIGHTS = [4, 5, 6]; // altos que fabrica el taller, en pies

// Medidas de cada tablilla, en pulgadas, según el material
const SIZES: Record<string, number[]> = {
  aluminio: [2, 3, 4, 5],
  pvc: [3.5, 5.5, 7.5, 9],
  acrilico: [2, 2.5, 3, 3.5, 4],
  led: [2, 2.5, 3, 3.5, 4], // la tira LED va dentro de una tablilla de acrílico
};
const DEF_SIZE: Record<string, number> = { aluminio: 5, pvc: 5.5, acrilico: 3, led: 3 };

// Materiales de las tablillas. sw es la muestra de color que ve el cliente.
const MATERIALS = [
  { id: "aluminio", es: "Aluminio", en: "Aluminum", sw: "linear-gradient(180deg,#43484F,#17181B 62%,#30343A)" },
  { id: "pvc", es: "PVC decorativo", en: "Decorative PVC", sw: "linear-gradient(180deg,#CEA077,#B5814A 42%,#7E5A33)" },
  { id: "acrilico", es: "Acrílico", en: "Acrylic", sw: "linear-gradient(180deg,#E8F6FD,#9ED2EA 62%,#D2EAF6)" },
  { id: "led", es: "Luz LED (acrílico)", en: "LED light (acrylic)", sw: "linear-gradient(180deg,#16181F 28%,#FFC98A 50%,#16181F 72%)" },
];
// Acabado del aluminio: postes, marco y tablillas de aluminio
const COLORS = [
  { id: "negro", hex: "#1D1E21", es: "Negro", en: "Black" },
  { id: "blanco", hex: "#ECEBE6", es: "Blanco", en: "White" },
