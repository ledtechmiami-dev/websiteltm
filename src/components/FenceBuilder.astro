        <fieldset class="nb__group">
          <legend class="nb__label">{c.caps}</legend>
          <div class="nb__seg" role="radiogroup" aria-label={c.caps} aria-describedby="fb-caps-help">
            {seg("topes", c.capsOpts).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" id="fb-caps-help">{c.capsHelp}</p>
