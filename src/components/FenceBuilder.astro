const seg = (name: string, options: Record<string, string>, checked?: string) =>
  Object.entries(options).map(([id, label], i) => ({ name, id, label, checked: checked ? id === checked : i === 0 }));
---
<section class="section" id="disena">
  <div class="container">
    <div class="sec-head">
      <div>
        <h2>{c.title}</h2>
        <p>{c.lead}</p>
      </div>
    </div>

    <div class="nb fb" data-fence data-cfg={JSON.stringify(cfg)}>
      <div class="nb__stage">
        <canvas class="nb__canvas fb__canvas" role="img" aria-label={c.preview}></canvas>
        <div class="nb__tools">
          <button type="button" class="nb__tool" data-night aria-pressed="false">
            <span class="nb__dot" aria-hidden="true"></span>{c.night}
          </button>
        </div>
        <p class="nb__approx">{c.approx}</p>
      </div>

      <form class="nb__panel" novalidate>
        <fieldset class="nb__group">
          <legend class="nb__label">{c.height}</legend>
          <div class="nb__seg" role="radiogroup" aria-label={c.height}>
            {HEIGHTS.map((h) => (
              <label>
                <input type="radio" name="alto" value={h} checked={h === 5} />
                <span>{h} ft</span>
              </label>
            ))}
          </div>
          <p class="nb__help"><span data-slats-out></span> · {c.heightHelp}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.len}</legend>
          <div class="eb__row">
            <div class="field">
              <label for="fb-largo">{c.lenLbl}</label>
              <input id="fb-largo" type="number" name="largo" min="4" max="400" step="1" value="40" inputmode="numeric" />
            </div>
          </div>
          <div class="cl__len">
            <span>{c.lenOut}</span>
            <output data-panels-out>—</output>
          </div>
          <p class="nb__help" data-len-help></p>
          <p class="tb__sub">{c.post}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.post}>
            {seg("postes", c.postOpts, "4").map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help">{c.postHelp}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.material}</legend>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.material}>
            {seg("modo", c.modes).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <div class="nb__colors" data-mats>
            {MATERIALS.map((m, i) => (
              <label class="nb__color fb__mat">
                <input type="radio" name="material" value={m.id} checked={i === 0} />
                <i style={`--c:${m.sw}`} aria-hidden="true"></i>
                <span>{m[lang]}</span>
              </label>
            ))}
          </div>
          <p class="nb__help" data-mat-help>{c.matHelp.aluminio}</p>
          <div class="fb__size-row" data-size-row>
            <label class="fb__size-lbl" for="fb-medida">{c.sizeLbl}</label>
            <select class="fb__size" id="fb-medida" name="medida"></select>
          </div>
