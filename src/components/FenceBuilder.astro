        <fieldset class="nb__group" data-pat2-group hidden>
          <legend class="nb__label">{c.pattern2}</legend>
          <div class="fb__pats" role="radiogroup" aria-label={c.pattern2}>
            {PATS.map((p) => (
              <label class="fb__pat">
                <input type="radio" name="patron2" value={p.id} checked={p.id === "celosia"} />
                <canvas width="208" height="112" aria-hidden="true"></canvas>
                <span>{p[lang]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="nb__group" data-mix hidden>
          <legend class="nb__label">{c.design}</legend>
          <p class="nb__help">{c.designHelp}</p>
          <p class="tb__sub">{c.colorsLbl}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.colorsLbl}>
            {seg("colores", c.colorModes).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" data-multi-help hidden>{c.multiHelp}</p>
          <div class="fb__slats" data-slats></div>
          <p class="nb__help" data-budget></p>
          <div class="fb__quick">
            <button type="button" class="nb__pill" data-add>{c.addSlat}</button>
            <button type="button" class="nb__pill" data-close>{c.fillPanel}</button>
            <button type="button" class="nb__pill" data-fill>{c.fillAll}</button>
            <button type="button" class="nb__pill" data-half>{c.half}</button>
            <button type="button" class="nb__pill" data-alt>{c.alternate}</button>
          </div>
        </fieldset>

        <fieldset class="nb__group" data-alu-group>
          <legend class="nb__label"><span data-color-lbl>{c.color}</span>: <span class="eb__picked" data-color-name></span></legend>
          <div class="eb__sws">
            {COLORS.map((x) => (
              <label class="eb__sw" title={x[lang]}>
                <input type="radio" name="color" value={x.id} checked={x.id === "negro"} aria-label={x[lang]} />
                <i style={`--c:${x.wood ? `linear-gradient(145deg,#B98A52,${x.hex} 48%,#5E3C21)` : x.hex}`} aria-hidden="true"></i>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.postColor}: <span class="eb__picked" data-pcolor-name></span></legend>
          <div class="eb__sws">
            {COLORS.map((x) => (
              <label class="eb__sw" title={x[lang]}>
                <input type="radio" name="cpostes" value={x.id} checked={x.id === "negro"} aria-label={x[lang]} />
                <i style={`--c:${x.wood ? `linear-gradient(145deg,#B98A52,${x.hex} 48%,#5E3C21)` : x.hex}`} aria-hidden="true"></i>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="nb__group" data-pvc-group hidden>
          <legend class="nb__label"><span data-pvc-lbl>{c.pvcColor}</span>: <span class="eb__picked" data-pvc-name></span></legend>
          <div class="eb__sws">
            {PVCS.map((x) => (
              <label class="eb__sw" title={x[lang]}>
                <input type="radio" name="pvc" value={x.id} checked={x.id === "roble"} aria-label={x[lang]} />
                <i style={`--c:${x.wood ? `linear-gradient(145deg,#D8A879,${x.hex} 48%,#4A2E18)` : x.hex}`} aria-hidden="true"></i>
              </label>
