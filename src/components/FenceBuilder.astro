  { id: "roble", hex: "#B5814A", wood: true, es: "Roble", en: "Oak" },
  { id: "nogal", hex: "#7A4A2B", wood: true, es: "Nogal", en: "Walnut" },
  { id: "gris-claro", hex: "#B7B4AE", es: "Gris claro", en: "Light gray" },
  { id: "gris-oscuro", hex: "#56595B", es: "Gris oscuro", en: "Dark gray" },
