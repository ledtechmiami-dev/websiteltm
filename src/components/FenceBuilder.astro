          <p class="tb__sub">{c.use}</p>
          <div class="nb__seg eb__seg3" role="radiogroup" aria-label={c.use}>
            {seg("uso", c.uses).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
