        </fieldset>

        <fieldset class="nb__group" data-vary-group hidden>
          <legend class="nb__label">{c.vary}</legend>
          <div class="nb__seg" role="radiogroup" aria-label={c.vary}>
            {seg("variacion", c.varyOpts).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
