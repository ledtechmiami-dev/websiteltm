        <fieldset class="nb__group" data-light-group>
          <legend class="nb__label">{c.light}: <span class="eb__picked" data-light-name></span></legend>
          <div class="eb__sws">
            {LIGHTS.map((x) => (
              <label class="eb__sw" title={x[lang]}>
                <input type="radio" name="luz" value={x.id} checked={x.id === "calido"} aria-label={x[lang]} />
