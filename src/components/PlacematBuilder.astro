    sBg: c.sBg,
    sImage: c.sImage,
    sName: c.sName,
    sList: c.sList,
    sNote: c.sNote,
    sBiz: c.sBiz,
    sBack: c.sBack,
    sQty: c.sQty,
    sLink: c.sLink,
    waIntro: c.waIntro,
    preview: c.preview,
  },
};
const waPhoto = `https://wa.me/${SITE.phoneIntl}?text=${encodeURIComponent(c.imageWa)}`;
const seg = (name: string, options: Record<string, string>, checked?: string) =>
  Object.entries(options).map(([id, label], i) => ({ name, id, label, checked: checked ? id === checked : i === 0 }));
const TPLS = Object.keys(c.tpls);
---
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" />

<section class="section section--flush" id="disena">
  <div class="container">
    <div class="sec-head">
      <div>
        <h2>{c.title}</h2>
        <p>{c.lead}</p>
      </div>
    </div>

    <div class="nb pm" data-mantel data-cfg={JSON.stringify(cfg)}>
      <div class="nb__stage">
        <canvas class="nb__canvas pm__canvas" role="img" aria-label={c.preview}></canvas>
        <div class="nb__tools">
          <button type="button" class="nb__tool" data-guides aria-pressed="false">
            <span class="nb__dot" aria-hidden="true"></span>{c.guides}
          </button>
          <button type="button" class="nb__tool" data-table aria-pressed="false">
            <span class="nb__dot" aria-hidden="true"></span>{c.table}
          </button>
          <button type="button" class="nb__tool pm__view" data-view title={c.viewHelp}>{c.views.ambas}</button>
        </div>
        <p class="nb__approx" data-approx>{c.approx}</p>
      </div>

      <form class="nb__panel" novalidate>
        <fieldset class="nb__group">
          <legend class="nb__label">{c.format}</legend>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.format}>
            {seg("formato", c.shapes, "mesa").map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help"><b data-size-out></b> · <span data-shape-help>{c.shapeHelp.mesa}</span></p>
          {menuUrl && (
            <p class="nb__help">{c.menuLink} <a class="eb__link" href={menuUrl}>{c.menuCta}</a>.</p>
          )}
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.paper}</legend>
          <div class="tb__mats">
            {STOCKS.map((s) => (
              <label class="tb__mat">
                <input type="radio" name="papel" value={s.id} checked={s.id === "mate"} />
                <i style={`--c:${s.sw}`} aria-hidden="true"></i>
                <span>{s[lang]}</span>
              </label>
            ))}
          </div>
          <p class="nb__help">{c.paperHelp}</p>
          <p class="nb__help pm__use"><b>{c.use}:</b> <span data-use>{c.uses.unico}</span></p>
          <p class="nb__help" data-crayon hidden>{c.crayon}</p>
          <p class="nb__help">{c.noLam}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.print}</legend>
          <div class="nb__seg" role="radiogroup" aria-label={c.sides}>
            {seg("caras", c.sideOpts).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" data-side-help>{c.sideHelp.una}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.design}</legend>
          <div class="fb__pats pm__tpls" role="radiogroup" aria-label={c.design}>
            {TPLS.map((id, i) => (
              <label class="fb__pat pm__tpl">
                <input type="radio" name="plantilla" value={id} checked={i === 0} />
                <canvas width="180" height="120" aria-hidden="true"></canvas>
                <span>{c.tpls[id as keyof typeof c.tpls]}</span>
              </label>
            ))}
          </div>
          <p class="nb__help" data-tpl-help>{c.tplHelp.marco}</p>
          <p class="tb__sub">{c.boxes}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.boxes} data-boxes>
            {BOXES.map((n, i) => (
              <label><input type="radio" name="casillas" value={n} checked={i === 1} /><span>{n}</span></label>
            ))}
          </div>
          <p class="nb__help">{c.boxesHelp}</p>
          <p class="tb__sub">{c.bg}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.bg}>
            {seg("fondo", c.bgs).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="tb__sub">{c.type}</p>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.type}>
            {seg("tipografia", c.types, "clasica").map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="tb__sub">{c.accent} · <span class="eb__picked" data-accent-name>{ACCENTS[0][lang]}</span></p>
          <div class="eb__sws" role="radiogroup" aria-label={c.accent}>
            {ACCENTS.map((a, i) => (
              <label class="eb__sw" title={a[lang]}>
                <input type="radio" name="acento" value={a.id} checked={i === 0} />
                <i style={`--c:${a.hex}`} aria-hidden="true"></i>
                <span class="sr-only">{a[lang]}</span>
              </label>
            ))}
          </div>
          <p class="tb__sub">{c.image}</p>
          <div class="nb__seg" role="radiogroup" aria-label={c.image} data-image>
            {seg("imagen", c.images).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help">{c.imageHelp} <a class="eb__link" href={waPhoto} target="_blank" rel="noopener">{c.imageCta}</a>.</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.words}</legend>
          <div class="tb__words">
            <div class="form__row">
              <div class="field">
                <label for="pm-negocio">{c.business}</label>
                <input id="pm-negocio" type="text" name="negocio" maxlength="28" autocomplete="off" placeholder={c.businessPh} value={c.defBusiness} />
              </div>
              <div class="field">
                <label for="pm-lema">{c.tag}</label>
                <input id="pm-lema" type="text" name="lema" maxlength="38" autocomplete="off" placeholder={c.tagPh} value={c.defTag} />
              </div>
            </div>

            <div class="field">
              <label for="pm-sec1">{c.sec1}</label>
              <input id="pm-sec1" type="text" name="seccion1" maxlength="24" autocomplete="off" value={c.defSec1} />
            </div>
            <div class="pm__rows">
              {[1, 2, 3, 4].map((n) => (
                <div class="pm__row">
                  <div class="field">
                    <input type="text" name={`plato${n}`} maxlength="30" autocomplete="off" value={c.dishes[n - 1]} aria-label={`${c.dish} ${n}`} />
                  </div>
                  <div class="field">
                    <input type="text" name={`precio${n}`} maxlength="8" autocomplete="off" value={c.prices[n - 1]} aria-label={`${c.priceCol} ${n}`} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.biz}</legend>
          <div class="tb__words">
            <div class="field">
              <label for="pm-nota">{c.note}</label>
              <input id="pm-nota" type="text" name="nota" maxlength="54" autocomplete="off" placeholder={c.notePh} value={c.defNote} />
            </div>
            <div class="form__row">
              <div class="field">
                <label for="pm-tel">{c.phone}</label>
                <input id="pm-tel" type="text" name="tel" maxlength="24" autocomplete="off" placeholder={c.phonePh} value={c.defPhone} />
              </div>
              <div class="field">
                <label for="pm-web">{c.web}</label>
                <input id="pm-web" type="text" name="web" maxlength="30" autocomplete="off" placeholder={c.webPh} value={c.defWeb} />
              </div>
            </div>
            <div class="field">
              <label for="pm-dir">{c.address}</label>
              <input id="pm-dir" type="text" name="direccion" maxlength="44" autocomplete="off" placeholder={c.addressPh} value={c.defAddress} />
            </div>
          </div>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.back}</legend>
          <div class="nb__seg nb__seg--wrap" role="radiogroup" aria-label={c.back} data-back>
            {seg("reverso", c.backs).map((o) => (
              <label><input type="radio" name={o.name} value={o.id} checked={o.checked} /><span>{o.label}</span></label>
            ))}
          </div>
          <p class="nb__help" data-back-help hidden>{c.backHelp}</p>
        </fieldset>

        <fieldset class="nb__group">
          <legend class="nb__label">{c.order}</legend>
          <div class="nb__sizes">
            {QTYS.map((q) => (
              <button type="button" class="nb__pill" data-qty={q}>{q}</button>
            ))}
          </div>
          <div class="tb__row">
            <div class="field">
              <label for="pm-cantidad">{c.qty}</label>
              <input id="pm-cantidad" type="number" name="cantidad" min="50" max="100000" step="50" value="100" inputmode="numeric" aria-describedby="pm-qty-help" />
            </div>
          </div>
          <p class="nb__help" id="pm-qty-help">{c.qtyHelp}</p>
        </fieldset>

        <div class="nb__foot">
          <p class="nb__price">{c.price}</p>
          <BuilderContact lang={lang} idp="pm" cta={c.cta} notesPh={c.notesPh} />
          <a class="wa-link" data-wa href={`https://wa.me/${SITE.phoneIntl}`} target="_blank" rel="noopener">
            <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>{c.wa}
          </a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { wireQuote } from "../scripts/builder-quote";

  type Stock = { id: string; name: string; base: string; edge: string; ink: string; sub: string; tex: string; use: string };
  type Accent = { id: string; name: string; hex: string };
  type Cfg = {
    stocks: Stock[];
    accents: Accent[];
    shapes: Record<string, string>;
    shapeHelp: Record<string, string>;
    uses: Record<string, string>;
    sides: Record<string, string>;
    sideHelp: Record<string, string>;
    tpls: Record<string, string>;
    tplHelp: Record<string, string>;
    types: Record<string, string>;
    bgs: Record<string, string>;
    images: Record<string, string>;
    backs: Record<string, string>;
    views: Record<string, string>;
    phone: string;
    formValue: string;
    lang: string;
    copy: Record<string, string>;
  };
  type Row = { dish: string; price: string };
  // Lo que hay que dibujar en una plana, ya resuelto desde el formulario
  type Face = {
    w: number; // pulgadas
    h: number;
    stock: Stock;
    accent: string;
    type: string;
    tpl: string;
    bg: string;
    photo: boolean;
    boxes: number;
    t: Record<string, string>;
    title: string;
    rows: Row[];
    mini: boolean;
  };

  // Medidas de mantel, en pulgadas. Acostados: el mantel siempre va a lo ancho.
  const SHAPES: Record<string, { w: number; h: number }> = {
    bandeja: { w: 14, h: 10 },
    mesa: { w: 17, h: 11 },
    grande: { w: 18, h: 12 },
  };
  const BLEED = 0.125; // sangrado de imprenta
  const SAFE = 0.25; // margen de seguridad hacia dentro
  const PLATE = 10.5; // el plato llano de siempre, en pulgadas

  const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  // Luminancia relativa: decide si sobre ese color el texto va blanco o negro
  const lum = (hex: string) =>
    rgb(hex)
      .map((v) => v / 255)
      .map((v) => (v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)))
      .reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0);
  const onColor = (hex: string) => (lum(hex) > 0.42 ? "#0B0C0E" : "#FFFFFF");
  const mix = (hex: string, t: number) => {
    const to = t < 0 ? 0 : 255;
    const a = Math.abs(t);
    const [r, g, b] = rgb(hex).map((v) => Math.round(v + (to - v) * a));
    return `rgb(${r},${g},${b})`;
  };
  // Azar con semilla: la textura del papel no cambia en cada redibujado

  // Medidas en pulgadas, escritas como en la imprenta: 10-1/2 in
  const fmtIn = (v: number) => {
    const whole = Math.floor(v);
    const fr = +(v - whole).toFixed(3);
    const frac: Record<string, string> = { "0.25": "-1/4", "0.5": "-1/2", "0.75": "-3/4" };
    const f = frac[String(fr)];
    if (f) return `${whole}${f}`;
    return fr ? String(+v.toFixed(2)) : String(whole);
  };

  const FAMS: Record<string, { title: string; body: string; track: string }> = {
    moderna: { title: '800 {px}px "Saira", "Arial Narrow", sans-serif', body: '500 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
    clasica: { title: '700 {px}px "Playfair Display", Georgia, serif', body: '400 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
    tecnica: { title: '400 {px}px "Michroma", "Eurostile", sans-serif', body: '500 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.02em" },
    sencilla: { title: '600 {px}px "Instrument Sans", system-ui, sans-serif', body: '400 {px}px "Instrument Sans", system-ui, sans-serif', track: "0.01em" },
  };
  const LABEL = (px: number) => `400 ${px}px "Michroma", "Eurostile", sans-serif`;
  const setTrack = (c: CanvasRenderingContext2D, v: string) => {
    (c as unknown as { letterSpacing: string }).letterSpacing = v;
  };

  const root = document.querySelector<HTMLElement>("[data-mantel]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const cfg: Cfg = JSON.parse(root.dataset.cfg!);
    const form = root.querySelector<HTMLFormElement>(".nb__panel")!;
    const canvas = root.querySelector<HTMLCanvasElement>(".nb__canvas")!;
    const ctx = canvas.getContext("2d")!;
    const guidesBtn = root.querySelector<HTMLButtonElement>("[data-guides]")!;
    const tableBtn = root.querySelector<HTMLButtonElement>("[data-table]")!;
    const viewBtn = root.querySelector<HTMLButtonElement>("[data-view]")!;
    const tools = root.querySelector<HTMLElement>(".nb__tools")!;
    const approx = root.querySelector<HTMLElement>("[data-approx]")!;
    const sizeOut = form.querySelector<HTMLElement>("[data-size-out]")!;
    const shapeHelp = form.querySelector<HTMLElement>("[data-shape-help]")!;
    const useOut = form.querySelector<HTMLElement>("[data-use]")!;
    const crayonHelp = form.querySelector<HTMLElement>("[data-crayon]")!;
    const sideHelp = form.querySelector<HTMLElement>("[data-side-help]")!;
    const tplHelp = form.querySelector<HTMLElement>("[data-tpl-help]")!;
    const boxesSeg = form.querySelector<HTMLElement>("[data-boxes]")!;
    const imageSeg = form.querySelector<HTMLElement>("[data-image]")!;
    const backSeg = form.querySelector<HTMLElement>("[data-back]")!;
    const backHelp = form.querySelector<HTMLElement>("[data-back-help]")!;
    const accentName = form.querySelector<HTMLElement>("[data-accent-name]")!;
    const qtyEl = form.querySelector<HTMLInputElement>("input[name='cantidad']")!;
    const waEl = form.querySelector<HTMLAnchorElement>("[data-wa]")!;
    const contactBox = form.querySelector<HTMLElement>(".nb__contact")!;

    let guides = false;
    let setting = false; // el plato puesto encima
    const VIEWS = ["ambas", "frente", "reverso"] as const;
    let view: (typeof VIEWS)[number] = "ambas";
    let touched = false; // la dirección cambia solo cuando el cliente toca algo

    const val = (name: string) => (form.elements.namedItem(name) as RadioNodeList).value;
    const text = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value.trim();
    const setRadio = (name: string, v: string | null) => {
      if (!v) return;
      const input = form.querySelector<HTMLInputElement>(`input[name='${name}'][value='${CSS.escape(v)}']`);
      if (input) input.checked = true;
    };
    const stock = () => cfg.stocks.find((s) => s.id === val("papel")) ?? cfg.stocks[0];
    const accent = () => cfg.accents.find((a) => a.id === val("acento")) ?? cfg.accents[0];
    const twoSided = () => val("caras") === "dos";
    const hasPhoto = () => val("plantilla") === "foto";
    const hasAds = () => val("plantilla") === "anuncios";
    // Los juegos van en la plana de niños y en el reverso de juegos
    const kids = () => val("plantilla") === "ninos";
    const qty = () => Math.max(50, Math.min(100000, Math.round(Number(qtyEl.value) || 100)));
    const dims = () => SHAPES[val("formato")] ?? SHAPES.mesa;
    const texts = () => ({
      negocio: text("negocio"),
      lema: text("lema"),
      nota: text("nota"),
      tel: text("tel"),
      web: text("web"),
      direccion: text("direccion"),
    });
    const rows = (): Row[] =>
      [1, 2, 3, 4].map((i) => ({ dish: text(`plato${i}`), price: text(`precio${i}`) })).filter((r) => r.dish);

    // ---------- Estado en la dirección: el diseño se puede compartir ----------
    const RADIOS = ["formato", "papel", "caras", "plantilla", "casillas", "fondo", "tipografia", "acento", "imagen", "reverso"];
    const FIELDS: Array<[string, number]> = [
      ["negocio", 28],
      ["lema", 38],
      ["seccion1", 24],
      ["plato1", 30],
      ["precio1", 8],
      ["plato2", 30],
      ["precio2", 8],
      ["plato3", 30],
      ["precio3", 8],
      ["plato4", 30],
      ["precio4", 8],
      ["nota", 54],
      ["tel", 24],
      ["web", 30],
      ["direccion", 44],
    ];
    const params = new URLSearchParams(location.search);
    if (params.has("plantilla") && params.has("formato")) {
      RADIOS.forEach((n) => setRadio(n, params.get(n)));
      FIELDS.forEach(([n, max]) => {
        const v = params.get(n);
        if (v !== null) (form.elements.namedItem(n) as HTMLInputElement).value = v.slice(0, max);
      });
      const q = Number(params.get("cantidad"));
      if (q >= 50 && q <= 100000) qtyEl.value = String(Math.round(q));
    }
    const shareUrl = () => {
      const p = new URLSearchParams();
      RADIOS.forEach((n) => p.set(n, val(n)));
      FIELDS.forEach(([n]) => p.set(n, text(n)));
      p.set("cantidad", String(qty()));
      return `${location.origin}${location.pathname}?${p}#disena`;
    };
    let urlTimer = 0;
    const syncUrl = () => {
      clearTimeout(urlTimer);
      urlTimer = window.setTimeout(() => history.replaceState(null, "", shareUrl()), 400);
    };

    // ---------- Dibujo ----------
    // Textura del papel. El sin estucar se ve con fibra; el sintético, con brillo.
    const paper = (c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, st: Stock, s: number) => {
      c.fillStyle = st.base;
      c.fillRect(x, y, w, h);
      if (st.tex === "brillo") {
        const g = c.createLinearGradient(x, y + h, x + w, y);
        g.addColorStop(0, "rgba(255,255,255,0)");
        g.addColorStop(0.44, "rgba(255,255,255,0)");
        g.addColorStop(0.5, "rgba(255,255,255,0.4)");
        g.addColorStop(0.56, "rgba(255,255,255,0)");
        g.addColorStop(1, "rgba(180,200,215,0.14)");
        c.fillStyle = g;
        c.fillRect(x, y, w, h);
      }
      const sh = c.createLinearGradient(x, y, x, y + h);
      sh.addColorStop(0, "rgba(255,255,255,0.12)");
      sh.addColorStop(0.5, "rgba(255,255,255,0)");
      sh.addColorStop(1, "rgba(11,12,14,0.06)");
      c.fillStyle = sh;
      c.fillRect(x, y, w, h);
    };

    // Dibuja una plana del mantel
    const drawFace = (c: CanvasRenderingContext2D, x0: number, y0: number, s: number, o: Face, back: string | null) => {
      const { w, h } = o;
      const X = (v: number) => x0 + v * s;
      const Y = (v: number) => y0 + v * s;
      const P = (v: number) => v * s;
      const st = o.stock;
      const acc = o.accent;
      const fu = h; // acostado: la unidad de tamaño de letra manda por el alto
      const m = 0.055 * w; // margen lateral
      const vm = 0.07 * h; // margen de arriba y abajo
      const V = (k: number) => k * h;

      // ---- Fondo ----
      paper(c, X(0), Y(0), P(w), P(h), st, s);
      const dark = o.bg === "oscuro";
      const colored = o.bg === "color";
      if (dark || colored) {
        c.fillStyle = dark ? "#14161A" : acc;
        c.fillRect(X(0), Y(0), P(w), P(h));
        c.save();
        c.globalAlpha = 0.12;
        c.globalCompositeOperation = "overlay";
        paper(c, X(0), Y(0), P(w), P(h), st, s);
        c.restore();
      }
      const ink = dark ? "#FFFFFF" : colored ? onColor(acc) : st.ink;
      const sub = dark ? "#AEB5BD" : colored ? mix(onColor(acc), onColor(acc) === "#FFFFFF" ? -0.2 : 0.35) : st.sub;
      const mark = colored ? ink : acc;
      const rule = dark ? "rgba(255,255,255,0.28)" : colored ? "rgba(255,255,255,0.45)" : "rgba(11,12,14,0.2)";

      const fam = () => FAMS[o.type] ?? FAMS.moderna;
      const make = (kind: "title" | "body" | "label", px: number) =>
        kind === "label" ? LABEL(px) : fam()[kind].replace("{px}", String(px));

      // Un renglón de texto; en las miniaturas se sustituye por una barra
      const put = (
        txt: string,
        kind: "title" | "body" | "label",
        sizeIn: number,
        xIn: number,
        yIn: number,
        maxIn: number,
        color: string,
        align: CanvasTextAlign = "left",
        upper = false
      ) => {
        if (!txt) return 0;
        const px = Math.max(1, P(sizeIn));
        const maxPx = P(maxIn);
        const t = upper ? txt.toLocaleUpperCase() : txt;
        setTrack(c, kind === "label" ? "0.1em" : fam().track);
        c.font = make(kind, px);
        let wd = c.measureText(t).width;
        if (wd > maxPx && wd > 0) {
          c.font = make(kind, px * (maxPx / wd));
          wd = maxPx;
        }
        c.fillStyle = color;
        c.textAlign = align;
        c.textBaseline = "alphabetic";
        if (o.mini) {
          const bh = Math.max(1, px * 0.58);
          const bx = align === "right" ? X(xIn) - wd : align === "center" ? X(xIn) - wd / 2 : X(xIn);
          c.fillRect(bx, Y(yIn) - bh, wd, bh);
        } else {
          c.fillText(t, X(xIn), Y(yIn));
        }
        setTrack(c, "0px");
        return wd / s;
      };

      // Un filete horizontal, de x1 a x2 a la altura y
      const line = (x1: number, y: number, x2: number, color = rule, lw = 1) => {
        c.strokeStyle = color;
        c.lineWidth = Math.max(1, lw);
        c.beginPath();
        c.moveTo(X(x1), Y(y));
        c.lineTo(X(x2), Y(y));
        c.stroke();
      };
      // Hueco de la foto: rayado en diagonal con su rótulo, o un bloque de color
      const image = (xIn: number, yIn: number, wIn: number, hIn: number) => {
        const ix = X(xIn);
        const iy = Y(yIn);
        const iw = P(wIn);
        const ih = P(hIn);
        if (!o.photo) {
          c.fillStyle = mark;
          c.fillRect(ix, iy, iw, ih);
          return;
        }
        c.save();
        c.beginPath();
        c.rect(ix, iy, iw, ih);
        c.clip();
        c.fillStyle = dark ? "#2A2E34" : colored ? mix(acc, onColor(acc) === "#FFFFFF" ? -0.18 : 0.2) : "#E4E7EA";
        c.fillRect(ix, iy, iw, ih);
        c.strokeStyle = dark ? "rgba(255,255,255,0.1)" : "rgba(11,12,14,0.09)";
        c.lineWidth = Math.max(1, P(0.02));
        const step = Math.max(6, P(0.3));
        c.beginPath();
        for (let i = -ih; i < iw; i += step) {
          c.moveTo(ix + i, iy + ih);
          c.lineTo(ix + i + ih, iy);
        }
        c.stroke();
        c.restore();
        if (!o.mini) {
          const lbl = Math.min(hIn * 0.09, wIn * 0.1);
          put(cfg.copy.photoBox, "label", lbl, xIn + wIn / 2, yIn + hIn / 2 + lbl * 0.4, wIn * 0.8, dark ? "#8D949C" : colored ? sub : "#8A9099", "center");
        }
      };

      // El renglón de la lista: plato, precio y la fila de puntos que los une
      const dishRow = (row: Row, xIn: number, yIn: number, wIn: number, sizeIn: number) => {
        const nameW = put(row.dish, "body", sizeIn, xIn, yIn, wIn * 0.74, ink);
        if (!row.price) return;
        setTrack(c, fam().track);
        c.font = make("body", Math.max(1, P(sizeIn)));
        const priceW = c.measureText(row.price).width / s;
        put(row.price, "body", sizeIn, xIn + wIn, yIn, wIn * 0.26, mark, "right");
        setTrack(c, "0px");
        if (o.mini) return;
        const from = xIn + nameW + sizeIn * 0.4;
        const to = xIn + wIn - priceW - sizeIn * 0.4;
        if (to <= from) return;
        c.save();
        c.strokeStyle = rule;
        c.lineWidth = 1;
        c.setLineDash([1, Math.max(2, P(0.05))]);
        c.lineCap = "round";
        c.beginPath();
        c.moveTo(X(from), Y(yIn - sizeIn * 0.12));
        c.lineTo(X(to), Y(yIn - sizeIn * 0.12));
        c.stroke();
        c.restore();
      };

      // La lista completa, repartida en la banda que le toca
      const list = (xIn: number, topIn: number, wIn: number, hIn: number, center = false) => {
        const n = o.rows.length;
        const units = (o.title ? 2.1 : 0) + n;
        const step = hIn / Math.max(1, units + 0.4);
        const size = Math.min(step * 0.5, wIn * 0.075, h * 0.05);
        let y = topIn + step;
        if (o.title) {
          put(o.title, "title", size * 1.15, center ? xIn + wIn / 2 : xIn, y, wIn, mark, center ? "center" : "left");
          line(xIn, y + size * 0.5, xIn + wIn);
          y += step * 1.4;
        }
        o.rows.forEach((r) => {
          dishRow(r, xIn, y, wIn, size);
          y += step;
        });
      };

      // Una casilla de anuncio: el recuadro vacío que le vendes al vecino
      const adBox = (xIn: number, yIn: number, wIn: number, hIn: number, n: number) => {
        c.save();
        c.strokeStyle = dark || colored ? "rgba(255,255,255,0.5)" : mix(acc, 0.3);
        c.lineWidth = Math.max(1, P(0.012));
        c.setLineDash([Math.max(3, P(0.07)), Math.max(2, P(0.05))]);
        c.beginPath();
        c.rect(X(xIn), Y(yIn), P(wIn), P(hIn));
        c.stroke();
        c.restore();
        if (o.mini) return;
        const lbl = Math.min(hIn * 0.2, wIn * 0.12, h * 0.022);
        put(`${cfg.copy.boxLbl} ${n}`, "label", lbl, xIn + wIn / 2, yIn + hIn / 2 + lbl * 0.4, wIn * 0.82, sub, "center");
      };

      // Los juegos: gato, unir los puntos y estrellas para colorear
      const ticTac = (xIn: number, yIn: number, sideIn: number) => {
        c.save();
        c.strokeStyle = mark;
        c.lineWidth = Math.max(1, P(0.03));
        c.lineCap = "round";
        c.beginPath();
        for (let i = 1; i < 3; i++) {
          c.moveTo(X(xIn + (sideIn / 3) * i), Y(yIn + sideIn * 0.04));
          c.lineTo(X(xIn + (sideIn / 3) * i), Y(yIn + sideIn * 0.96));
          c.moveTo(X(xIn + sideIn * 0.04), Y(yIn + (sideIn / 3) * i));
          c.lineTo(X(xIn + sideIn * 0.96), Y(yIn + (sideIn / 3) * i));
        }
        c.stroke();
        c.restore();
      };
      const dots = (cxIn: number, cyIn: number, rIn: number) => {
        c.save();
        c.fillStyle = mark;
        const n = 10;
        for (let i = 0; i < n; i++) {
          const a = (i / n) * Math.PI * 2 - Math.PI / 2;
          const px = cxIn + Math.cos(a) * rIn;
          const py = cyIn + Math.sin(a) * rIn * 0.86;
          c.beginPath();
          c.arc(X(px), Y(py), Math.max(1.4, P(0.035)), 0, Math.PI * 2);
          c.fill();
          // El número va por fuera del aro: dentro se come el dibujo
          if (!o.mini) {
            const lbl = Math.min(rIn * 0.3, h * 0.024);
            put(String(i + 1), "body", lbl, cxIn + Math.cos(a) * rIn * 1.34, cyIn + Math.sin(a) * rIn * 0.86 * 1.34 + lbl * 0.35, rIn, sub, "center");
            c.fillStyle = mark;
          }
        }
        c.restore();
      };
      const star = (cxIn: number, cyIn: number, rIn: number) => {
        c.save();
        c.strokeStyle = mark;
        c.lineWidth = Math.max(1, P(0.022));
        c.beginPath();
        for (let i = 0; i < 10; i++) {
          const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
          const rr = i % 2 ? rIn * 0.46 : rIn;
          const px = X(cxIn + Math.cos(a) * rr);
          const py = Y(cyIn + Math.sin(a) * rr);
          if (i) c.lineTo(px, py);
          else c.moveTo(px, py);
        }
        c.closePath();
        c.stroke();
        c.restore();
      };
      // La plana de juegos: tres columnas, una por juego. Los niños pintan
      // antes de que llegue la comida, así que aquí sí se usa todo el mantel.
      const gamesFace = (titled: boolean) => {
        const gut = w * 0.025;
        const col = (w - m * 2 - gut * 2) / 3;
        const cxs = [0, 1, 2].map((i) => m + col / 2 + i * (col + gut));
        const labY = titled ? V(0.34) : V(0.28);
        const midY = titled ? V(0.63) : V(0.58);
        if (titled) {
          put(o.t.negocio, "title", 0.075 * fu, w / 2, V(0.13), w * 0.5, ink, "center");
          put(cfg.copy.games, "label", 0.04 * fu, w / 2, V(0.21), w * 0.45, mark, "center");
          line(w / 2 - w * 0.09, V(0.245), w / 2 + w * 0.09, mark, Math.max(1, P(0.012)));
        } else {
          put(o.t.negocio, "title", 0.07 * fu, m, V(0.13), w * 0.4, ink);
          if (o.t.lema) put(o.t.lema, "body", 0.032 * fu, w - m, V(0.13), w * 0.36, sub, "right");
          line(m, V(0.18), w - m);
        }
        put(cfg.copy.gameTic, "label", 0.033 * fu, cxs[0], labY, col * 0.9, sub, "center");
        const side = Math.min(col * 0.72, h * 0.36);
        ticTac(cxs[0] - side / 2, midY - side / 2, side);
        put(cfg.copy.gameDots, "label", 0.033 * fu, cxs[1], labY, col * 0.9, sub, "center");
        dots(cxs[1], midY, Math.min(col * 0.3, h * 0.15));
        put(cfg.copy.gameColor, "label", 0.033 * fu, cxs[2], labY, col * 0.9, sub, "center");
        const sr = Math.min(col * 0.12, h * 0.065);
        ([[-1.25, -0.9], [0, -0.9], [1.25, -0.9], [-0.62, 0.9], [0.62, 0.9]] as Array<[number, number]>).forEach(([dx, dy]) =>
          star(cxs[2] + dx * sr * 2.2, midY + dy * sr * 2.2, sr)
        );
        const foot = [o.t.direccion, o.t.tel, o.t.web].filter(Boolean).join("   ·   ");
        put(foot, "body", 0.03 * fu, w / 2, V(0.955), w - m * 2, sub, "center");
      };

      const t = o.t;
      const foot = [t.direccion, t.tel, t.web].filter(Boolean).join("   ·   ");

      // ---- Reverso ----
      if (back === "info") {
        put(t.negocio, "title", 0.1 * fu, w / 2, V(0.26), w * 0.66, ink, "center");
        if (t.lema) put(t.lema, "body", 0.035 * fu, w / 2, V(0.33), w * 0.6, sub, "center");
        line(w / 2 - w * 0.12, V(0.38), w / 2 + w * 0.12, mark, Math.max(1, P(0.012)));
        put(cfg.copy.hours, "label", 0.032 * fu, w / 2, V(0.47), w * 0.5, mark, "center");
        put(t.direccion, "body", 0.04 * fu, w / 2, V(0.57), w * 0.66, ink, "center");
        put(t.tel, "title", 0.07 * fu, w / 2, V(0.69), w * 0.5, mark, "center");
        put(t.web, "body", 0.038 * fu, w / 2, V(0.78), w * 0.5, sub, "center");
        put(t.nota, "body", 0.03 * fu, w / 2, V(0.93), w - m * 2, sub, "center");
        return;
      }
      if (back === "juegos") {
        gamesFace(true);
        return;
      }

      // ---- La plana de arriba ----
      if (o.tpl === "marco") {
        // Doble filete alrededor: el centro queda limpio para el plato
        c.strokeStyle = mark;
        c.lineWidth = Math.max(1, P(0.022));
        c.strokeRect(X(m * 0.5), Y(vm * 0.5), P(w - m), P(h - vm));
        c.lineWidth = 1;
        c.strokeStyle = rule;
        c.strokeRect(X(m * 0.8), Y(vm * 0.8), P(w - m * 1.6), P(h - vm * 1.6));
        // Cuadritos de acento en las esquinas, como una greca de imprenta
        const d = Math.min(w, h) * 0.014;
        c.fillStyle = mark;
        [
          [m * 1.3, vm * 1.3],
          [w - m * 1.3 - d, vm * 1.3],
          [m * 1.3, h - vm * 1.3 - d],
          [w - m * 1.3 - d, h - vm * 1.3 - d],
        ].forEach(([bx, by]) => c.fillRect(X(bx), Y(by), P(d), P(d)));
        put(t.lema, "label", 0.034 * fu, w / 2, V(0.145), w * 0.5, sub, "center", true);
        put(t.negocio, "title", 0.105 * fu, w / 2, V(0.27), w * 0.62, ink, "center");
        line(w / 2 - w * 0.07, V(0.32), w / 2 + w * 0.07, mark, Math.max(1, P(0.014)));
        // Pegados al borde de abajo: ahí el plato ya no llega
        put(t.nota, "body", 0.032 * fu, w / 2, V(0.885), w * 0.6, sub, "center");
        put(foot, "body", 0.034 * fu, w / 2, V(0.945), w - m * 3, ink, "center");
      } else if (o.tpl === "especiales") {
        const col = w * 0.3;
        put(t.negocio, "title", 0.085 * fu, m, V(0.14), w * 0.42, ink);
        if (t.lema) put(t.lema, "body", 0.032 * fu, m, V(0.2), w * 0.42, sub);
        line(m, V(0.24), m + col, mark, Math.max(1, P(0.014)));
        list(m, V(0.26), col, h * 0.56);
        // Arriba a la derecha va el vaso: ese rincón se deja libre a propósito
        line(m, V(0.9), w - m);
        put(t.nota, "body", 0.03 * fu, m, V(0.95), w * 0.5, sub);
        put(foot, "body", 0.03 * fu, w - m, V(0.95), w * 0.45, ink, "right");
      } else if (o.tpl === "anuncios") {
        // Anillo de casillas: dos en los lados y el resto arriba y abajo
        const n = Math.max(8, Math.min(12, o.boxes));
        const cols = Math.round((n - 2) / 2);
        const sideW = w * 0.17;
        const bandH = h * 0.17;
        const gap = w * 0.012;
        const innerX = m + sideW + gap;
        const innerW = w - m * 2 - (sideW + gap) * 2;
        const bw = (innerW - gap * (cols - 1)) / cols;
        for (let i = 0; i < cols; i++) {
          adBox(innerX + i * (bw + gap), vm * 0.6, bw, bandH, i + 1);
          adBox(innerX + i * (bw + gap), h - vm * 0.6 - bandH, bw, bandH, cols + 3 + i);
        }
        const sideY = vm * 0.6;
        const sideH = h - vm * 1.2;
        adBox(m, sideY, sideW, sideH, cols + 1);
        adBox(w - m - sideW, sideY, sideW, sideH, cols + 2);
        // En el centro, el negocio: es decoración, el plato se lo come
        put(t.negocio, "title", 0.1 * fu, w / 2, V(0.44), innerW * 0.9, ink, "center");
        if (t.lema) put(t.lema, "body", 0.034 * fu, w / 2, V(0.51), innerW * 0.8, sub, "center");
        put(t.tel, "title", 0.058 * fu, w / 2, V(0.6), innerW * 0.6, mark, "center");
        put(foot, "body", 0.028 * fu, w / 2, V(0.66), innerW * 0.9, sub, "center");
      } else if (o.tpl === "ninos") {
        gamesFace(false);
      } else {
        // foto: la imagen en la columna de la izquierda y el nombre al lado
        const col = w * 0.3;
        image(0, 0, col, h);
        const cx = col + (w - col) / 2;
        put(t.lema, "label", 0.032 * fu, cx, V(0.16), (w - col) * 0.6, sub, "center", true);
        put(t.negocio, "title", 0.1 * fu, cx, V(0.28), (w - col) * 0.7, ink, "center");
        line(cx - w * 0.06, V(0.33), cx + w * 0.06, mark, Math.max(1, P(0.014)));
        put(t.nota, "body", 0.032 * fu, cx, V(0.82), (w - col) * 0.7, sub, "center");
        put(foot, "body", 0.034 * fu, cx, V(0.89), (w - col) * 0.85, ink, "center");
      }
    };

    // El servicio puesto encima, a escala: el plato, los cubiertos y el vaso
    const drawSetting = (x0: number, y0: number, s: number, o: Face) => {
      const { w, h } = o;
      const X = (v: number) => x0 + v * s;
      const Y = (v: number) => y0 + v * s;
      const P = (v: number) => v * s;
      // El plato más grande que cabe dejando el borde de abajo libre para los datos
      const dia = Math.min(PLATE, h - 1.9);
      const r = dia / 2;
      const cx = w / 2;
      const cy = h * 0.52;
      const long = Math.min(7.6, h - 1.6); // el largo de un cubierto de mesa

      // Sobre un mantel oscuro el azul no se ve: el servicio se dibuja en claro
      const onDark = o.bg === "oscuro";
      const fill = onDark ? "rgba(196,219,242,0.2)" : "rgba(22,48,79,0.17)";
      const edge = onDark ? "#C4DBF2" : "#16304F";
      const soft = onDark ? "rgba(196,219,242,0.55)" : "rgba(22,48,79,0.5)";

      ctx.save();
      ctx.fillStyle = fill;
      ctx.strokeStyle = edge;

      // Cubiertos: el tenedor a la izquierda, el cuchillo y la cuchara a la derecha
      const piece = (xIn: number, wIn: number) => {
        ctx.beginPath();
        ctx.roundRect(X(xIn - wIn / 2), Y(cy - long / 2), P(wIn), P(long), P(wIn / 2));
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.stroke();
      };
      ctx.lineWidth = 1;
      piece(cx - r - 0.95, 0.42);
      piece(cx + r + 0.7, 0.44);
      piece(cx + r + 1.35, 0.42);
      // Los dientes del tenedor
      ctx.save();
      ctx.strokeStyle = soft;
      ctx.lineWidth = Math.max(1, P(0.045));
      ctx.beginPath();
      for (let i = 0; i < 3; i++) {
        const fx = cx - r - 0.95 - 0.13 + i * 0.13;
        ctx.moveTo(X(fx), Y(cy - long / 2 + 0.16));
        ctx.lineTo(X(fx), Y(cy - long / 2 + 1.05));
      }
      ctx.stroke();
      ctx.restore();

      // El plato: el borde y el fondo
      ctx.beginPath();
      ctx.arc(X(cx), Y(cy), P(r), 0, Math.PI * 2);
      ctx.fill();
      ctx.setLineDash([Math.max(4, P(0.14)), Math.max(3, P(0.1))]);
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.lineWidth = 1;
      ctx.strokeStyle = soft;
      ctx.beginPath();
      ctx.arc(X(cx), Y(cy), P(r * 0.72), 0, Math.PI * 2);
      ctx.stroke();

      // El vaso, arriba a la derecha del plato
      const gr = Math.min(1.6, h * 0.14);
      ctx.fillStyle = fill;
      ctx.strokeStyle = edge;
      ctx.beginPath();
      ctx.arc(X(cx + r * 0.8), Y(cy - r * 0.82), P(gr), 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.strokeStyle = soft;
      ctx.beginPath();
      ctx.arc(X(cx + r * 0.8), Y(cy - r * 0.82), P(gr * 0.72), 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();

      // El rótulo va en una pastilla: encima del dibujo no se leería
      ctx.font = `600 11px "Instrument Sans", system-ui, sans-serif`;
      const lw = ctx.measureText(cfg.copy.plateLbl).width;
      ctx.fillStyle = "rgba(255,255,255,0.94)";
      ctx.strokeStyle = "#16304F";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(X(cx) - lw / 2 - 7, Y(cy) - 10, lw + 14, 20, 10);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = "#16304F";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(cfg.copy.plateLbl, X(cx), Y(cy) + 1);
      ctx.textBaseline = "alphabetic";
    };

    // Una plana completa: sombra, papel, diseño, servicio y guías
    const drawSheet = (x0: number, y0: number, s: number, o: Face, back: string | null) => {
      const wPx = o.w * s;
      const hPx = o.h * s;
      ctx.save();
      ctx.shadowColor = "rgba(18,26,36,0.4)";
      ctx.shadowBlur = 22;
      ctx.shadowOffsetY = 10;
      ctx.fillStyle = o.stock.edge;
      ctx.fillRect(x0, y0, wPx, hPx);
      ctx.restore();

      ctx.save();
      ctx.beginPath();
      ctx.rect(x0, y0, wPx, hPx);
      ctx.clip();
      drawFace(ctx, x0, y0, s, o, back);
      // El brillante levanta un reflejo encima de la plana
      if (o.stock.tex === "brillo") {
        const g = ctx.createLinearGradient(x0, y0 + hPx, x0 + wPx, y0);
        g.addColorStop(0, "rgba(255,255,255,0)");
        g.addColorStop(0.46, "rgba(255,255,255,0)");
        g.addColorStop(0.52, "rgba(255,255,255,0.26)");
        g.addColorStop(0.58, "rgba(255,255,255,0)");
        g.addColorStop(1, "rgba(255,255,255,0)");
        ctx.fillStyle = g;
        ctx.fillRect(x0, y0, wPx, hPx);
      }
      ctx.restore();

      ctx.lineWidth = 1;
      ctx.strokeStyle = "rgba(11,12,14,0.26)";
      ctx.strokeRect(x0, y0, wPx, hPx);

      // El servicio solo encima de la plana de arriba: es la que se ve en la mesa
      if (setting && !back) drawSetting(x0, y0, s, o);

      if (guides) {
        ctx.save();
        ctx.lineWidth = 1;
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = "#ED1B24";
        ctx.strokeRect(x0 - BLEED * s, y0 - BLEED * s, wPx + BLEED * 2 * s, hPx + BLEED * 2 * s);
        ctx.strokeStyle = "#0094DA";
        ctx.strokeRect(x0 + SAFE * s, y0 + SAFE * s, wPx - SAFE * 2 * s, hPx - SAFE * 2 * s);
        ctx.restore();
      }
    };

    const face = (mini: boolean, tpl?: string): Face => ({
      ...dims(),
      stock: stock(),
      accent: accent().hex,
      type: val("tipografia"),
      tpl: tpl ?? val("plantilla"),
      bg: val("fondo"),
      photo: val("imagen") === "foto",
      boxes: Number(val("casillas")) || 10,
      t: texts(),
      title: text("seccion1"),
      rows: rows(),
      mini,
    });

    const draw = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const cw = canvas.clientWidth;
      const ch = canvas.clientHeight;
      if (!cw || !ch) return;
      if (canvas.width !== Math.round(cw * dpr) || canvas.height !== Math.round(ch * dpr)) {
        canvas.width = Math.round(cw * dpr);
        canvas.height = Math.round(ch * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cw, ch);

      const { w, h } = dims();
      const two = twoSided();
      // El reverso "el mismo diseño" se dibuja igual que el frente
      const backOf = () => (val("reverso") === "repetir" ? "repetir" : val("reverso"));
      const faces: Array<string | null> = !two
        ? [null]
        : view === "frente"
          ? [null]
          : view === "reverso"
            ? [backOf()]
            : [null, backOf()];
      const n = faces.length;
      const top = tools.offsetHeight + 24;
      const keep = top + 50 + (approx.offsetParent ? 34 : 0);
      const gap = w * 0.1;
      const pad = guides ? 0.4 : 0.08;
      // Dos planas: se prueba una al lado de otra y una debajo de otra
      const fit = (cols: number, rows2: number) =>
        Math.min(
          (cw - 44) / (w * cols + gap * (cols - 1) + pad * 2),
          (ch - keep - (rows2 > 1 ? 26 : 0)) / (h * rows2 + gap * (rows2 - 1) + pad * 2)
        );
      const side = fit(n, 1);
      const stack = n > 1 ? fit(1, n) : side;
      const rows2 = stack > side ? n : 1;
      const cols = rows2 === 1 ? n : 1;
      const s = Math.max(side, stack);
      const groupW = w * cols + gap * (cols - 1);
      const groupH = h * rows2 + gap * (rows2 - 1);
      const x0 = (cw - groupW * s) / 2;
      const y0 = Math.max(top, 16 + (ch - groupH * s - 50) / 2);
      const at = (i: number) => ({
        x: x0 + (cols > 1 ? i * (w + gap) * s : 0),
        y: y0 + (rows2 > 1 ? i * (h + gap) * s : 0),
      });

      faces.forEach((back, i) => {
        const p = at(i);
        // "repetir" dibuja el frente otra vez: no es una plana distinta
        drawSheet(p.x, p.y, s, face(false), back === "repetir" ? null : back);
      });

      // Rótulo de cada plana, debajo
      if (n > 1 || view !== "ambas") {
        ctx.fillStyle = "rgba(11,12,14,0.6)";
        ctx.font = `600 12px "Instrument Sans", system-ui, sans-serif`;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        faces.forEach((back, i) => {
          const p = at(i);
          ctx.fillText(back ? cfg.copy.backLbl : cfg.copy.front, p.x + (w * s) / 2, p.y + h * s + 7);
        });
      }

      // Cota del ancho, debajo del grupo
      const gy = y0 + groupH * s + (n > 1 || view !== "ambas" ? 30 : 20);
      const tick = 5;
      ctx.strokeStyle = "rgba(11,12,14,0.5)";
      ctx.fillStyle = "rgba(11,12,14,0.66)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x0, gy);
      ctx.lineTo(x0 + w * s, gy);
      ctx.moveTo(x0, gy - tick);
      ctx.lineTo(x0, gy + tick);
      ctx.moveTo(x0 + w * s, gy - tick);
      ctx.lineTo(x0 + w * s, gy + tick);
      ctx.stroke();
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      ctx.font = `500 12px "Instrument Sans", system-ui, sans-serif`;
      const txt = `${fmtIn(w)} × ${fmtIn(h)} in · ${stock().name} · ${cfg.uses[stock().use]}`;
      const half = ctx.measureText(txt).width / 2;
      ctx.fillText(txt, Math.min(Math.max(x0 + (w * s) / 2, half + 8), cw - half - 8), gy + 7);

      canvas.setAttribute(
        "aria-label",
        `${cfg.copy.preview}: ${fmtIn(w)} × ${fmtIn(h)} in · ${stock().name} · ${cfg.tpls[val("plantilla")]} · ${accent().name}${texts().negocio ? ` · "${texts().negocio}"` : ""}`
      );
    };

    // Miniaturas de los diseños, con el mismo dibujo que la vista previa
    const renderTpls = () => {
      const ids = Object.keys(cfg.tpls);
      form.querySelectorAll<HTMLCanvasElement>(".pm__tpl canvas").forEach((cv, i) => {
        const c2 = cv.getContext("2d")!;
        const o: Face = { ...face(true, ids[i] ?? ids[0]), w: 17, h: 11 };
        c2.setTransform(1, 0, 0, 1, 0, 0);
        c2.clearRect(0, 0, cv.width, cv.height);
        const s = Math.min((cv.width - 10) / o.w, (cv.height - 10) / o.h);
        const x = (cv.width - o.w * s) / 2;
        const y = (cv.height - o.h * s) / 2;
        c2.save();
        c2.beginPath();
        c2.rect(x, y, o.w * s, o.h * s);
        c2.clip();
        drawFace(c2, x, y, s, o, null);
        c2.restore();
        c2.lineWidth = 1;
        c2.strokeStyle = "rgba(11,12,14,0.22)";
        c2.strokeRect(x, y, o.w * s, o.h * s);
      });
    };

    // ---------- Resumen para la cotización ----------
    const summary = () => {
      const k = cfg.copy;
      const { w, h } = dims();
      const t = texts();
      const rs = rows();
      const listTxt = rs.length
        ? `${text("seccion1")}: ${rs.map((r) => `${r.dish}${r.price ? ` ${r.price}` : ""}`).join(", ")}`
        : "";
      const out = [
        `${k.summary}:`,
        `• ${k.sFormat}: ${cfg.shapes[val("formato")]} ${fmtIn(w)} × ${fmtIn(h)} in`,
        `• ${k.sPaper}: ${stock().name}`,
        `• ${k.sUse}: ${cfg.uses[stock().use]}`,
        `• ${k.sSides}: ${cfg.sides[val("caras")]}`,
        `• ${k.sDesign}: ${cfg.tpls[val("plantilla")]}`,
        `• ${k.sBg}: ${cfg.bgs[val("fondo")]}`,
        `• ${k.sType}: ${cfg.types[val("tipografia")]}`,
        `• ${k.sAccent}: ${accent().name}`,
      ];
      if (hasAds()) out.push(`• ${k.sBoxes}: ${val("casillas")}`);
      if (hasPhoto()) out.push(`• ${k.sImage}: ${cfg.images[val("imagen")]}`);
      out.push(`• ${k.sName}: ${[t.negocio, t.lema].filter(Boolean).join(" · ")}`);
      if (listTxt) out.push(`• ${k.sList}: ${listTxt}`);
      if (t.nota) out.push(`• ${k.sNote}: "${t.nota}"`);
      out.push(`• ${k.sBiz}: ${[t.direccion, t.tel, t.web].filter(Boolean).join(" / ")}`);
      if (twoSided()) out.push(`• ${k.sBack}: ${cfg.backs[val("reverso")]}`);
      out.push(`• ${k.sQty}: ${qty()}`, `• ${k.sLink}: ${shareUrl()}`);
      return out.join("\n");
    };

    const syncUI = () => {
      const { w, h } = dims();
      boxesSeg.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !hasAds()));
      boxesSeg.toggleAttribute("data-off", !hasAds());
      imageSeg.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !hasPhoto()));
      imageSeg.toggleAttribute("data-off", !hasPhoto());
      backSeg.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.disabled = !twoSided()));
      backSeg.toggleAttribute("data-off", !twoSided());
      backHelp.hidden = twoSided();
      // El aviso del crayón solo cuando hay juegos y el papel no los agarra
      const drawn = kids() || (twoSided() && val("reverso") === "juegos");
      crayonHelp.hidden = !drawn;
      useOut.textContent = cfg.uses[stock().use] ?? "";
      sideHelp.textContent = cfg.sideHelp[val("caras")] ?? "";
      shapeHelp.textContent = cfg.shapeHelp[val("formato")] ?? "";
      tplHelp.textContent = cfg.tplHelp[val("plantilla")] ?? "";
      accentName.textContent = accent().name;
      sizeOut.textContent = `${fmtIn(w)} × ${fmtIn(h)} in`;
      approx.textContent = guides ? cfg.copy.guidesOn : setting ? cfg.copy.tableOn : cfg.copy.approx;
      guidesBtn.setAttribute("aria-pressed", String(guides));
      tableBtn.setAttribute("aria-pressed", String(setting));
      viewBtn.textContent = cfg.views[view];
      viewBtn.hidden = !twoSided();
      const q = qty();
      root.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.qty) === q)));
    };
    const update = () => {
      waEl.href = `https://wa.me/${cfg.phone}?text=${encodeURIComponent(`${cfg.copy.waIntro}\n\n${summary()}`)}`;
      if (touched) syncUrl();
    };
    const render = () => {
      syncUI();
      draw();
      renderTpls();
      update();
    };

    // ---------- Eventos ----------
    const onEdit = (e: Event) => {
      if (contactBox.contains(e.target as Node)) return;
      touched = true;
      render();
    };
    form.addEventListener("change", onEdit);
    form.addEventListener("input", onEdit);
    root.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) =>
      b.addEventListener("click", () => {
        qtyEl.value = b.dataset.qty!;
        touched = true;
        render();
      })
    );
    guidesBtn.addEventListener("click", () => {
      guides = !guides;
      syncUI();
      draw();
    });
    tableBtn.addEventListener("click", () => {
      setting = !setting;
      syncUI();
      draw();
    });
    viewBtn.addEventListener("click", () => {
      view = VIEWS[(VIEWS.indexOf(view) + 1) % VIEWS.length];
      syncUI();
      draw();
    });

    wireQuote(form, { formValue: cfg.formValue, lang: cfg.lang, summary });

    new ResizeObserver(() => draw()).observe(canvas);
    Promise.all(
      [`800 40px "Saira"`, `700 40px "Playfair Display"`, `400 40px "Michroma"`, `500 40px "Instrument Sans"`].map((f) =>
        document.fonts.load(f).catch(() => [])
      )
    ).then(() => render());
    render();
  }
</script>
