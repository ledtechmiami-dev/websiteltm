const c = COPY[lang];
const menuSvc = SERVICES.find((s) => s.key === "menus");
const menuUrl = menuSvc ? `${serviceUrl(menuSvc, lang)}#disena` : null;
const BOXES = ["8", "10", "12"];
const cfg = {
  stocks: STOCKS.map((s) => ({ id: s.id, base: s.base, edge: s.edge, ink: s.ink, sub: s.sub, tex: s.tex, use: s.use, name: s[lang] })),
  accents: ACCENTS.map((a) => ({ id: a.id, hex: a.hex, name: a[lang] })),
  shapes: c.shapes,
  shapeHelp: c.shapeHelp,
  uses: c.uses,
  sides: c.sideOpts,
  sideHelp: c.sideHelp,
  tpls: c.tpls,
  tplHelp: c.tplHelp,
  types: c.types,
  bgs: c.bgs,
  images: c.images,
  backs: c.backs,
  views: c.views,
  phone: SITE.phoneIntl,
  formValue,
  lang,
  copy: {
    photoBox: c.photoBox,
    boxLbl: c.boxLbl,
    hours: c.hours,
    games: c.games,
    gameTic: c.gameTic,
    gameDots: c.gameDots,
    gameColor: c.gameColor,
    plateLbl: c.plateLbl,
    front: c.front,
    backLbl: c.backLbl,
    approx: c.approx,
    guidesOn: c.guidesOn,
    tableOn: c.tableOn,
    crayon: c.crayon,
    use: c.use,
    summary: c.summary,
    sFormat: c.sFormat,
    sPaper: c.sPaper,
    sUse: c.sUse,
    sSides: c.sSides,
    sDesign: c.sDesign,
    sBoxes: c.sBoxes,
