const c = COPY[lang];
const cfg = {
  stocks: STOCKS.map((s) => ({ id: s.id, base: s.base, edge: s.edge, ink: s.ink, sub: s.sub, tex: s.tex, name: s[lang] })),
  accents: ACCENTS.map((a) => ({ id: a.id, hex: a.hex, name: a[lang] })),
  shapes: c.shapes,
  folds: c.folds,
  foldHelp: c.foldHelp,
  thicks: c.thicks,
  thickHelp: c.thickHelp,
  thickOff: c.thickOff,
  tpls: c.tpls,
  types: c.types,
  bgs: c.bgs,
  images: c.images,
  panels: c.panels,
  views: c.views,
  phone: SITE.phoneIntl,
  formValue,
  lang,
  copy: {
    photoBox: c.photoBox,
    extLbl: c.extLbl,
    intLbl: c.intLbl,
    panelLbl: c.panelLbl,
    approx: c.approx,
    guidesOn: c.guidesOn,
    summary: c.summary,
    sFormat: c.sFormat,
    sFold: c.sFold,
    sPaper: c.sPaper,
    sThick: c.sThick,
    sSides: c.sSides,
    sSidesVal: c.sSidesVal,
    sDesign: c.sDesign,
    sType: c.sType,
    sAccent: c.sAccent,
    sBg: c.sBg,
    sImage: c.sImage,
    sCover: c.sCover,
