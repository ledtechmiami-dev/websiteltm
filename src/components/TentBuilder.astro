const c = COPY[lang];
const cfg = {
  stocks: [...STOCKS, VINYL].map((s) => ({
    id: s.id, base: s.base, edge: s.edge, ink: s.ink, sub: s.sub, tex: s.tex, name: s[lang],
  })),
  accents: ACCENTS.map((a) => ({ id: a.id, hex: a.hex, name: a[lang] })),
  kinds: c.kinds,
  kindHelp: c.kindHelp,
  sizes: c.sizes,
  sizeHelp: c.sizeHelp,
  sides: c.sideOpts,
  sideHelp: c.sideHelp,
  tpls: c.tpls,
  tplHelp: c.tplHelp,
  types: c.types,
  bgs: c.bgs,
  images: c.images,
  backs: c.backs,
  views: c.views,
  qtyHelp: c.qtyHelp,
