    qrBox: c.qrBox,
    hours: c.hours,
    foldLbl: c.foldLbl,
    tabLbl: c.tabLbl,
    upsideLbl: c.upsideLbl,
    hideLbl: c.hideLbl,
    front: c.front,
    backLbl: c.backLbl,
