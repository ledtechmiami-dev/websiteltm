---
// Constructor de exhibidores de mesa (idea tomada de los de Vistaprint: carpas
// de mesa de 5 × 7 in en cartulina brillante o mate de 14 y 16 pt, que llegan
// —aquí solo 14 pt: el taller no hiende y la de 16 se raja en el doblez—
// planas y se paran solas con dos pestañas que se traban, desde 10; y mini
// banners retráctiles de mesa de 8-1/2 × 12 y 11 × 17 in, en vinilo, con la
// base armada y por una sola cara, desde 1; el banner viene armado de fábrica,
// no se hace aquí). Lo propio de este producto es que
// se arma: la carpa sale de una hoja con dos dobleces y el banner se enrolla
// dentro de la base. El constructor enseña las dos cosas. No muestra precios de
// imprenta: el precio de la impresión va en la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Cartulinas de la carpa. El vinilo del banner va aparte: no se elige.
const STOCKS = [
  { id: "brillante", es: "Brillante", en: "Glossy", base: "#FFFFFF", edge: "#E4E8EB", ink: "#14161A", sub: "#5A616B", tex: "brillo",
    sw: "linear-gradient(118deg, #FFF 0 26%, #D8E2EA 44%, #FFF 62%, #EDF1F4)" },
  { id: "mate", es: "Mate", en: "Matte", base: "#FFFFFF", edge: "#E7E8E6", ink: "#14161A", sub: "#5A616B", tex: "mate",
    sw: "linear-gradient(135deg, #FFF 0 52%, #EFF0EE)" },
];
const VINYL = { id: "vinilo", es: "Vinilo", en: "Vinyl", base: "#FDFEFF", edge: "#D5DEE4", ink: "#12161A", sub: "#56606A", tex: "vinilo" };

