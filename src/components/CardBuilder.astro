---
// Constructor de tarjetas de presentación (idea tomada del estudio de diseño de
// Vistaprint): el cliente elige formato, papel, grosor, acabado y un diseño, escribe
// sus datos y ve el frente y el reverso como salen impresos. El diseño se envía
// directo al correo. No muestra precios: el precio va en la cotización, porque
// depende del tiraje, del papel y del acabado.
// El dueño confirmó estas opciones tal como están: los papeles, los grosores,
// los acabados y los mínimos.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Papeles. base: color del papel; edge: el canto; ink / sub: los dos tonos de texto
// que se leen sobre ese papel. tex: cómo se dibuja la textura en la vista previa.
const STOCKS = [
  { id: "mate", es: "Mate", en: "Matte", base: "#FFFFFF", edge: "#E7E8E6", ink: "#14161A", sub: "#5A616B", tex: "mate",
    sw: "linear-gradient(135deg, #FFF 0 52%, #EFF0EE)" },
  { id: "brillante", es: "Brillante", en: "Glossy", base: "#FFFFFF", edge: "#E4E8EB", ink: "#14161A", sub: "#5A616B", tex: "brillo",
    sw: "linear-gradient(118deg, #FFF 0 26%, #D8E2EA 44%, #FFF 62%, #EDF1F4)" },
  { id: "natural", es: "Sin recubrir", en: "Uncoated", base: "#FAF8F3", edge: "#E6E1D6", ink: "#1A1A18", sub: "#5E5B52", tex: "fibra",
    sw: "linear-gradient(135deg, #FBF9F4, #EBE5D9)" },
  { id: "lino", es: "Lino", en: "Linen", base: "#FCFBF7", edge: "#E8E4DA", ink: "#17181A", sub: "#5C5F63", tex: "lino",
    sw: "repeating-linear-gradient(45deg, #FAF8F3 0 3px, #ECE7DC 3px 5px)" },
  { id: "kraft", es: "Kraft reciclado", en: "Recycled kraft", base: "#C9A67B", edge: "#A9875B", ink: "#36271A", sub: "#6B543A", tex: "kraft",
    sw: "linear-gradient(135deg, #CFAC81, #AE8A5C)" },
  { id: "perlado", es: "Perlado", en: "Pearl", base: "#F7F3EC", edge: "#E3DFD6", ink: "#17181A", sub: "#5C5F63", tex: "perla",
    sw: "linear-gradient(118deg, #F8F3EA, #E6E7F2 36%, #FDF9F1 56%, #E7EEF2)" },
];

// Colores de acento: la paleta LED del logo más neutros y metálicos de imprenta
const ACCENTS = [
  { id: "azul", es: "Azul LED", en: "LED blue", hex: "#0094DA" },
  { id: "amarillo", es: "Amarillo LED", en: "LED yellow", hex: "#FFCA09" },
  { id: "verde", es: "Verde LED", en: "LED green", hex: "#99C941" },
  { id: "rojo", es: "Rojo LED", en: "LED red", hex: "#ED1B24" },
  { id: "negro", es: "Negro", en: "Black", hex: "#0B0C0E" },
  { id: "pizarra", es: "Gris pizarra", en: "Slate grey", hex: "#59626D" },
  { id: "marino", es: "Azul marino", en: "Navy", hex: "#16304F" },
  { id: "vino", es: "Vino", en: "Wine", hex: "#7A1F2B" },
  { id: "oliva", es: "Verde oliva", en: "Olive", hex: "#4F5B32" },
  { id: "terracota", es: "Terracota", en: "Terracotta", hex: "#B4522E" },
];

// Tiradas habituales de imprenta
const QTYS = [100, 250, 500, 1000, 2500];

