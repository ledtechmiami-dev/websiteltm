const cfg = {
  stocks: STOCKS.map((s) => ({ id: s.id, base: s.base, edge: s.edge, ink: s.ink, sub: s.sub, tex: s.tex, name: s[lang] })),
  accents: ACCENTS.map((a) => ({ id: a.id, hex: a.hex, name: a[lang] })),
  shapes: c.shapes,
  shapeHelp: c.shapeHelp,
  stubs: c.stubs,
  numbers: c.numbers,
  numHelp: c.numHelp,
  outsource: c.outsource,
  inhouse: c.inhouse,
  numRange: c.numRange,
  sides: c.sideOpts,
  tpls: c.tpls,
  types: c.types,
  bgs: c.bgs,
  images: c.images,
  backs: c.backs,
  views: c.views,
  phone: SITE.phoneIntl,
  formValue,
  lang,
  copy: {
    photoBox: c.photoBox,
    keepOrg: c.keepOrg,
    keepGuest: c.keepGuest,
    nameLine: c.nameLine,
    phoneLine: c.phoneLine,
    raffleLbl: c.raffleLbl,
    admitLbl: c.admitLbl,
    numPrefix: c.numPrefix,
