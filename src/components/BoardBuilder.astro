---
// Constructor de tablas de cortar (idea tomada de las tablas personalizadas de Etsy):
// el cliente elige material, forma, medidas, grosor, canal para jugo, agarraderas y un
// diseño de grabado con sus textos, lo ve en la vista previa y envía el diseño directo al correo.
// No muestra precios: el precio llega con la cotización.
import type { Lang } from "../data/site";
import { SITE } from "../data/site";
import BuilderContact from "./BuilderContact.astro";

interface Props {
  lang: Lang;
  formValue: string;
}

const { lang, formValue } = Astro.props;

// Materiales del taller (confirmado el 2026-09-15: arce, nogal, acacia y HDPE; sin cerezo).
// strips: cuánto contrastan las tiras encoladas (la acacia tiene tiras claras y oscuras marcadas).
