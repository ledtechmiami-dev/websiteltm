  { id: "arce", es: "Arce", en: "Maple", base: "#E2C394", dark: "#C9A26E", grain: "rgba(140, 92, 42, 0.2)", ink: "rgba(74, 44, 20, 0.9)", strips: 0.06 },
  { id: "nogal", es: "Nogal", en: "Walnut", base: "#6E4C34", dark: "#553725", grain: "rgba(24, 14, 8, 0.3)", ink: "rgba(18, 11, 7, 0.9)", strips: 0.06 },
  { id: "acacia", es: "Acacia", en: "Acacia", base: "#A56B3A", dark: "#6F4221", grain: "rgba(58, 28, 10, 0.3)", ink: "rgba(34, 17, 7, 0.9)", strips: 0.14 },
  { id: "hdpe", es: "Polietileno marino (HDPE)", en: "Marine polyethylene (HDPE)", base: "#F3F3EF", dark: "#D9D9D3", grain: "", ink: "rgba(96, 102, 110, 0.85)", strips: 0 },
];
// Medidas rápidas: ancho × largo en pulgadas
const SIZES = [
  { w: 8, l: 10 },
  { w: 9, l: 12 },
  { w: 11, l: 14 },
  { w: 12, l: 18 },
];

