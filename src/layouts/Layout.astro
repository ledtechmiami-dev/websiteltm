---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../data/site";
import { SITE, waLink } from "../data/site";
import type { PageKey } from "../i18n/routes";
import { UI } from "../i18n/ui";

interface Props {
  lang: Lang;
  page: PageKey | "none";
  title: string;
  description: string;
  alternates: { es: string; en: string };
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const { lang, page, title, description, alternates, schema, noindex = false } = Astro.props;
const t = UI[lang];
const abs = (path: string) => new URL(path, SITE.url).href;
const canonical = abs(Astro.url.pathname);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={abs(alternates.es)} />
    <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternates.es)} />
    <meta name="theme-color" content="#0B0C0E" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs("/pictures/og-image.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/pictures/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/pictures/favicon-32.png" />
    <link rel="apple-touch-icon" href="/pictures/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Michroma&family=Saira:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>
      // Transición entre páginas: si el navegador se la salta —porque otra
      // navegación la interrumpe o el documento nuevo tarda— su promesa `ready`
      // queda rechazada sin nadie que la atienda y Chrome la reporta como
      // «AbortError: Transition was skipped». La atendemos para no ensuciar la
      // consola del visitante; saltarse la transición no rompe nada.
      (function () {
        var hush = function (e) {
          var vt = e.viewTransition;
          if (!vt) return;
          if (vt.ready) vt.ready.catch(function () {});
          if (vt.finished) vt.finished.catch(function () {});
        };
        addEventListener("pagereveal", hush);
        addEventListener("pageswap", hush);
      })();
      // Efectos solo si el usuario no pidió reducir el movimiento.
      // El logo se "enciende" una vez por visita, no en cada página.
      (function () {
        var d = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("js-motion");
        try {
          if (!sessionStorage.getItem("ltm-boot")) {
            d.classList.add("logo-boot");
            sessionStorage.setItem("ltm-boot", "1");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <svg class="sprite" aria-hidden="true" focusable="false">
      <symbol id="i-wa" viewBox="0 0 24 24">
        <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </symbol>
      <symbol id="i-phone" viewBox="0 0 24 24">
        <path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.12.37 2.33.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1Z" />
      </symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24">
        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
      <symbol id="i-chev" viewBox="0 0 24 24">
        <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
      <symbol id="i-instagram" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
      </symbol>
      <symbol id="i-facebook" viewBox="0 0 24 24">
        <path fill="currentColor" d="M13.6 21.5v-8.2h2.8l.4-3.3h-3.2V7.9c0-.9.3-1.6 1.6-1.6h1.7V3.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.4v3.3h2.8v8.2Z" />
      </symbol>
      <symbol id="i-cart" viewBox="0 0 24 24">
        <path d="M3 4h2.2l2.3 11.2a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.1L21 8H6.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="9.5" cy="20" r="1.5" fill="currentColor" />
        <circle cx="17.5" cy="20" r="1.5" fill="currentColor" />
      </symbol>
      <symbol id="i-menu" viewBox="0 0 24 24">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </symbol>
    </svg>

    <Header lang={lang} page={page} alternates={alternates} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />

    <a href={waLink(t.waText)} class="wa-float" target="_blank" rel="noopener" aria-label={t.waFloat}>
      <svg aria-hidden="true"><use href="#i-wa"></use></svg>
    </a>
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
